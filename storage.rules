rules_version = '2';

// Cloud Storage rules for MAPA. Files hosted in Storage today:
//   /onboarding/{reqId}/{file}     hospital onboarding papers (Super Admin only)
//   /profilePhotos/{uid}/{file}    profile photos
// Patient documents and signed GL scans live in Firestore; their old Storage
// paths are closed below.
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ────────────────────────────────────────────────────────
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function isAuth() {
      return request.auth != null;
    }
    function isPlatformAdmin() {
      return isAuth() && userDoc().data.role == 'platform_admin';
    }

    // ── Hospital onboarding documents ───────────────────────────────────
    // Letters of intent, MOAs, data processing agreements, DPO designations,
    // PIAs, go-live acceptances — filed by the Super Admin from what the
    // hospital sends. Network operator only: no hospital or patient access.
    match /onboarding/{reqId}/{file} {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/webp');
    }

    // ── Signed GL scans and patient documents: CLOSED ──────────────────
    // Both moved back into Firestore (certificates/{appId}.base64 and
    // documentContents/{docId}) while the project was on the Spark plan; no
    // production record points at a Storage object (checked 2026-11-15:
    // 0 documents and 0 certificates with a storagePath).
    //
    // The old rules here let ANY hospital's staff read or delete these files
    // (isAdmin() had no hospital check), which the Firestore rules don't
    // allow. Role review 2026-11-15: closed until files move back to Storage;
    // re-open them then with the same hospital scoping as Firestore (the
    // file's documents/{docId} or applications/{appId} tenantId must equal
    // the staff member's tenantId).
    match /certificates/{appId}/{file} {
      allow read, write: if false;
    }
    match /documents/{patientId}/{docId}/{file} {
      allow read, write: if false;
    }
    // ── Profile photos (Phase 2.4) ─────────────────────────────────────
    // Used to live as base64 strings in users/{uid}.photoURL -- a 200x200
    // JPEG (~10-25KB) inflated 33% by base64 ate up to 13% of the user
    // doc's 1MiB cap. Migrated to Cloud Storage so photos don't compete
    // with profile fields for the doc size budget.
    //
    // Path: /profilePhotos/{uid}/{file}. The {file} segment is usually
    // the literal string "avatar.jpg" so re-uploads overwrite the same
    // object (no orphaned old photos).
    //
    // Read: any signed-in user (photos appear on shared surfaces:
    // notification list, conversation threads, audit-log entries).
    // Write: only the user themselves. Size capped at 200KB (raw JPEG;
    // the client resizes to 200x200 well below this). Content type
    // strictly image/jpeg because that's what canvas.toDataURL emits.
    match /profilePhotos/{uid}/{file} {
      allow read:  if isAuth();
      allow write: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.size < 200 * 1024
                    && request.resource.contentType == 'image/jpeg';
      allow delete: if isAuth() && request.auth.uid == uid;
    }
  }
}