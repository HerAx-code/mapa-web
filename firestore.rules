rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads the current user's role from their Firestore profile.
    // Authenticated users always have a users/{uid} document (created on register/account-create).
    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function userAgencyId() {
      return get(/databases/$(database)/documents/users/$(uid())).data.agencyId;
    }

    function isSuperAdmin() {
      return isAuth() && userRole() == 'super_admin';
    }

    // Covers both super_admin and staff_admin
    function isAdmin() {
      return isAuth() && userRole() in ['super_admin', 'staff_admin'];
    }

    function isAgencyAdmin() {
      return isAuth() && userRole() == 'agency_admin';
    }

    // Convenience: covers both agency_admin (senior agency officer) and
    // agency (coordinator). Most case-handling permissions apply to both.
    function isAgency() {
      return isAuth() && userRole() in ['agency_admin', 'agency'];
    }

    function isPatient() {
      return isAuth() && userRole() == 'patient';
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Patients own their profile.
    // Admins and agencies can read all users (needed for messaging compose search
    // and for agencies to fetch patient address/hospitalId in the Inbox AppModal).
    //
    // Create split (post seed refactor):
    //   - self-create: userId must equal uid AND role must be 'patient'.
    //     This is the patient registration flow. Self-creating with any
    //     other role would let an attacker mint themselves admin / agency
    //     privileges immediately after createUserWithEmailAndPassword.
    //   - isAdmin: any role, any user. Covers admin/Accounts.jsx which
    //     uses a secondary Firebase app to create new admins/coordinators
    //     while the current admin session writes the user doc.
    //   - isAgencyAdmin: own-agency coordinators only. Covers agency/Team.jsx
    //     where an agency admin adds a new coordinator to their own agency.
    //
    // Seed admin/agency_admin/agency users come from scripts/bootstrap-users.js
    // which uses the Admin SDK and bypasses Firestore rules entirely; the /seed
    // web page no longer self-creates users.
    match /users/{userId} {
      // Read rule additions for the patient compose-message flow:
      //   - Patients can read CRMC admin (super_admin / staff_admin) user
      //     docs so the New Message picker can list them. Without this
      //     the picker silently fails (the original rule treated patients
      //     the same as unauthenticated for cross-user reads, but the
      //     messaging feature has always required the patient to know
      //     who's on the other side).
      //   - Patients can read agency staff (agency / agency_admin) user
      //     docs. Their names + roles are operational, not sensitive --
      //     the patient already sees the agency on their slice and on
      //     /agency catalog pages.
      // Field exposure is still limited to operational fields (name,
      // role, agencyId, email, contact). No password, no PII beyond
      // contact email/phone. Sensitive patient data lives in
      // patients/{uid} which keeps its tighter rule.
      allow read:   if isAuth() && (
        uid() == userId
        || isAdmin()
        || isAgency()
        || resource.data.role in ['super_admin', 'staff_admin', 'agency', 'agency_admin']
      );
      allow create: if isAuth() && (
        (uid() == userId && request.resource.data.role == 'patient') ||
        isAdmin() ||
        (isAgencyAdmin() &&
         request.resource.data.agencyId == userAgencyId() &&
         request.resource.data.role in ['agency', 'agency_admin'])
      );
      // Update permissions:
      //   - self: only profile fields. role / agencyId / active / rank are
      //     managed elsewhere — without this, any user could self-promote
      //     to super_admin by writing to their own user doc.
      //   - isAdmin (CRMC super/staff): can edit anything.
      //   - isAgencyAdmin: can edit members of their own agency, but only
      //     within the agency_admin/agency role pair and cannot move them
      //     to a different agency. This lets agency administrators manage
      //     their own coordinators without giving them platform-wide write.
      allow update: if isAuth() && (
        (uid() == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.agencyId == resource.data.agencyId &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.rank == resource.data.rank) ||
        isAdmin() ||
        (isAgencyAdmin() &&
          resource.data.agencyId == userAgencyId() &&
          resource.data.role in ['agency', 'agency_admin'] &&
          request.resource.data.agencyId == resource.data.agencyId &&
          request.resource.data.role in ['agency', 'agency_admin'])
      );
      allow delete: if isSuperAdmin();
    }

    // ── applications ──────────────────────────────────────────────────────────
    // Patients read/create their own applications.
    // Agencies read and update applications for their own agency.
    // Admins read and update all applications.
    match /applications/{appId} {
      allow read: if isAuth() && (
        resource.data.patientId == uid()  ||
        (isAgency() && resource.data.agencyId == userAgencyId()) ||
        // Co-funding: an agency may read every slice of a request it holds a
        // slice in (its id is in the parent request's agencyIds[]). This powers
        // the per-agency co-funding breakdown on the application detail view.
        // The client only surfaces agency name, amount, and status.
        (isAgency() && resource.data.requestId != null &&
          userAgencyId() in get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.agencyIds) ||
        isAdmin()
      );
      // isPatient: the legacy direct apply flow (still active during the
      // co-funding transition). isAdmin: CRMC creates application "slices"
      // when endorsing a request to an agency.
      allow create: if isPatient() || isAdmin();
      allow update: if isAuth() && (
        // Patient can make exactly two transitions on their own application:
        //  1. pending → rejected (self-withdrawal)
        //  2. awaiting_info → reviewing (responding to a "Request More Info"
        //     by uploading a document; the client flips status as part of
        //     the same write)
        // Any other status transition by a patient is denied here.
        (isPatient() && resource.data.patientId == uid() && (
          (resource.data.status == 'pending'       && request.resource.data.status == 'rejected') ||
          (resource.data.status == 'awaiting_info' && request.resource.data.status == 'reviewing') ||
          // Co-funding: patient accepts the coverage plan, advancing their
          // endorsed slice into the agency's review queue.
          (resource.data.status == 'endorsed'      && request.resource.data.status == 'reviewing')
        )) ||
        (isAgency() && resource.data.agencyId == userAgencyId()) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── requests ────────────────────────────────────────────────────────────
    // Co-funding parent: the patient's medical-assistance need + amount. CRMC
    // verifies it, then splits it into child application "slices" and endorses
    // them toward zero balance. Patients own and read their own request and may
    // withdraw it while still 'submitted'. CRMC admins manage all. An agency
    // can read a request only if it holds a slice in it (its id is in
    // agencyIds[]), and may update ONLY the funding tally fields when recording
    // an approval against its slice — never patient data, the target amount, or
    // the agency list. (The applications/create rule still gates slice creation
    // to CRMC at cutover; this block is additive and does not change the
    // existing apply flow.)
    match /requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.patientId == uid() ||
        isAdmin() ||
        (isAgency() && userAgencyId() in resource.data.agencyIds)
      );
      allow create: if isPatient() && request.resource.data.patientId == uid();
      allow update: if isAdmin() ||
        (isPatient() && resource.data.patientId == uid() &&
          resource.data.status == 'submitted' &&
          request.resource.data.status == 'closed') ||
        // Patient fills the factual portion of their own intake sheet (the
        // CRMC assessment fields are written by admins). Only the intakeSheet
        // field may change via this path.
        (isPatient() && resource.data.patientId == uid() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['intakeSheet', 'updatedAt'])) ||
        (isAgency() && userAgencyId() in resource.data.agencyIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['amountCommitted', 'status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ── documents ─────────────────────────────────────────────────────────────
    // Patients own their documents.
    // Agencies can read all patient documents (needed for application review).
    // Admins can read and update (verification status).
    match /documents/{docId} {
      // Agency reads are scoped to documents on requests they hold a slice
      // for. The endorse transaction (admin/Requests EndorseModal) stamps
      // an agencyIds[] array onto each attached document at endorse time,
      // and the /seed-page backfill stamped pre-existing legacy docs.
      //
      // R9 (2026-06-03): split into three allow read statements so each
      // is evaluated independently by Firestore's query-rule analyzer.
      // The original combined-OR clause + `is list` defensive check
      // confused the analyzer on the agency-side LIST query
      // `where('agencyIds', 'array-contains', userAgencyId)` -- the
      // analyzer couldn't determine that `array-contains` aligned with
      // the rule's `in` operator, so the query was denied even though
      // every individual result document would pass the rule. The
      // simpler single-clause form below works because the analyzer
      // can match `array-contains` directly against `in` without
      // intervening conjunctions.
      allow read: if isAuth() && resource.data.patientId == uid();
      allow read: if isAdmin();
      allow read: if isAgency() && userAgencyId() in resource.data.agencyIds;
      // Patient creates own document. patientId must match auth (no creating
      // docs attributed to other patients), status must start at 'pending'
      // (can't pre-stamp verified to bypass CRMC review), agencyIds[]
      // can't be pre-stamped (admins set this at endorse time, granting
      // agency read access), and storagePath cannot be present at create
      // time (it's stamped via update AFTER the actual Storage upload
      // succeeds -- pre-stamping a path that points elsewhere would let
      // the viewer load attacker-chosen Storage objects under the docId).
      // The OCR text from uploadDocument.js is already sliced to 2000 chars
      // client-side; we bound it server-side too.
      allow create: if isPatient() &&
                       request.resource.data.patientId == uid() &&
                       request.resource.data.status == 'pending' &&
                       !('agencyIds' in request.resource.data) &&
                       !('storagePath' in request.resource.data) &&
                       (!('ocrText' in request.resource.data) ||
                        (request.resource.data.ocrText is string &&
                         request.resource.data.ocrText.size() <= 4000));
      // CRMC-gateway redesign: document verification is CRMC's job (the single
      // intake gateway), so only admins verify/reject. Agencies keep READ for
      // the funding decision but no longer write document status. Patients may
      // re-upload their own (status reset handled by replacePatientDocument).
      allow update: if isAdmin() || (isPatient() && resource.data.patientId == uid());
      allow delete: if isAdmin() || (isPatient() && resource.data.patientId == uid());
    }

    // ── agencies ──────────────────────────────────────────────────────────────
    // Public read — landing page shows available programs to unauthenticated visitors.
    // Updates split by authority:
    //   - CRMC admin (super/staff): operational fields (name, enabled, slots,
    //     contact info, defaultSignatory, assistanceTypes, etc.) — but NOT
    //     budget.allocated / budget.committed / budget.disbursed.
    //   - agency_admin: own agency only. Can write budget fields (the
    //     allocation authority), plus the same operational fields.
    //   - agency coordinator: own agency only. Slots and similar low-impact
    //     operational fields (UI controls limit them to slot management today).
    // Field-level constraints are enforced in the client UI; the rules here
    // give the broad write permission. A tighter field-level guard can be
    // added later (request.resource.data.budget == resource.data.budget for
    // CRMC admin) once the UI gating is fully verified.
    match /agencies/{agencyId} {
      allow read:   if true;
      allow create: if isSuperAdmin();
      // Update authority split:
      //   - CRMC admin: anything (operational fields + emergency budget
      //     overrides during incident response).
      //   - agency_admin: own agency. Allowed to write budget.* because
      //     they are the allocation authority for their own fund source.
      //   - agency coordinator (role=='agency'): own agency, but the
      //     budget object must stay byte-identical. This prevents an
      //     authenticated coordinator from calling the Firestore SDK
      //     directly to inflate budget.allocated past whatever the UI
      //     gate enforces -- the previous version trusted the client
      //     for that.
      // Coordinator update rule (hotfix from prod):
      //   - The original rule required the entire budget object to be
      //     byte-identical, which blocked the GL-expiry sweep on the
      //     agency dashboard (it mutates `budget.committed` to release
      //     funds when a coordinator-issued GL lapses). Symptom in prod:
      //     "GL expiry sweep failed: Missing or insufficient permissions"
      //     on every coordinator dashboard load with at least one
      //     expired GL.
      //   - The threat the original rule guards is "coordinator inflates
      //     budget.allocated past the UI limit." That threat is
      //     preserved by pinning `allocated` and `fundSource` only.
      //     Usage-tracking fields (committed, disbursed, totalSpent)
      //     are allowed to change so automated transaction flows
      //     (GL expire, approval, redeem) work for non-admin agency
      //     coordinators.
      allow update: if isAdmin() ||
                       (isAgencyAdmin() && userAgencyId() == agencyId) ||
                       (isAgency() && !isAgencyAdmin() && userAgencyId() == agencyId &&
                        request.resource.data.budget.allocated == resource.data.budget.allocated &&
                        // .get(field, default) lets the rule tolerate
                        // budgets where fundSource hasn't been set yet
                        // (default null on both sides means equality holds);
                        // without it, the rule errors on the undefined-property
                        // access and denies the write.
                        request.resource.data.budget.get('fundSource', null) == resource.data.budget.get('fundSource', null));
      allow delete: if isSuperAdmin();
    }

    // ── documentTypes ─────────────────────────────────────────────────────────
    // All authenticated users can read (patients see requirements during apply).
    // Only super_admin can modify.
    match /documentTypes/{typeId} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── assistanceTypes ───────────────────────────────────────────────────────
    match /assistanceTypes/{typeId} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── hospitalIds ───────────────────────────────────────────────────────────
    // Unauthenticated single-document GET is needed for hospital ID verification
    // during patient registration (user is not yet logged in at that point).
    // Listing all IDs requires authentication.
    // Updates:
    //   - admin: anything (manual reset, status changes)
    //   - patient (registration claim): isAuth() rather than isPatient()
    //     because the patient's user doc is created in the SAME transaction
    //     as this hospitalIds update during registration. Firestore rules
    //     cannot see pending writes from the same transaction, so an
    //     isPatient() check (which does get(users/uid).role) would return
    //     false against the not-yet-committed user doc and fail the whole
    //     transaction with permission-denied. The field-level constraints
    //     (status must currently be 'available', must flip to 'used',
    //     patId must equal the requesting uid) carry the security here
    //     without needing the role lookup.
    // Only super_admin can create or delete IDs.
    match /hospitalIds/{hospitalId} {
      allow get:    if true;
      allow list:   if isAuth();
      allow create: if isSuperAdmin();
      allow update: if isAdmin() ||
                       (isAuth() &&
                        resource.data.status == 'available' &&
                        request.resource.data.status == 'used' &&
                        request.resource.data.patId == uid()) ||
                       // #9 — Agencies (and agency admins) may stamp the
                       // cooldown fields when approving or reversing an
                       // approval, but cannot touch status / usedBy / patId.
                       // Tracking cooldown here (keyed by the human's CRMC
                       // ID, not by the per-account UID) makes the 30-day
                       // lock survive account-deletion + re-registration.
                       (isAgency() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cooldownUntilAt', 'lastApprovedAt']));
      allow delete: if isSuperAdmin();

      // Phase 0.3 hardening (post-review): the patient NAME used to live on
      // the parent hospitalIds doc as `usedBy`, but the parent allows
      // unauthenticated GET (needed during registration verification --
      // patient is not yet logged in). That made every claimed code's
      // patient name publicly enumerable. Names + access codes are a
      // ready-made phishing kit.
      //
      // Fix: move the name to this sub-collection. By convention the
      // single doc per parent is keyed `details`, so admin code does one
      // get() per row instead of a query. The parent retains `patId`
      // (a uid — 28 random chars, doesn't enumerate, doesn't phish) so
      // the existing claim-transaction rule (line 320) keeps working.
      match /privateInfo/{infoId} {
        // Admins read all; the claimant patient reads their own (parent
        // doc's patId must equal the requesting uid). Agencies do NOT
        // need patient names from this collection -- they get them from
        // the users/{uid} doc via the application's patientId.
        allow read:   if isAdmin() ||
                         (isAuth() &&
                          get(/databases/$(database)/documents/hospitalIds/$(hospitalId)).data.patId == uid());
        // Create runs inside the registration claim transaction. Patient
        // user doc doesn't yet exist at that moment (same-transaction
        // limitation; see parent-update comment above for why isPatient()
        // fails here). isAuth() + self-attribution via usedById carries
        // the security.
        allow create: if isAuth() &&
                         request.resource.data.usedById == uid() &&
                         request.resource.data.usedBy is string &&
                         request.resource.data.usedBy.size() <= 120;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Only the owner can read and manage their notifications.
    // Any authenticated user can create a notification for any user (needed for
    // cross-role notifications: agency notifies patient, admin notifies agency,
    // etc.). Title and body are bounded so a malicious authenticated client
    // can't push a multi-KB payload (phishing copy, prompt-injection text)
    // into another user's notification panel.
    match /notifications/{userId}/items/{notifId} {
      allow read:   if isAuth() && uid() == userId;
      allow create: if isAuth() &&
                       (!('title' in request.resource.data) ||
                        (request.resource.data.title is string &&
                         request.resource.data.title.size() <= 200)) &&
                       (!('body' in request.resource.data) ||
                        (request.resource.data.body is string &&
                         request.resource.data.body.size() <= 2000));
      allow update: if isAuth() && uid() == userId;
      allow delete: if isAuth() && uid() == userId;
    }

    // ── conversations ─────────────────────────────────────────────────────────
    // Only participants can read and write a conversation and its messages.
    // Any authenticated user can create a conversation, but they MUST list
    // themselves in participants — otherwise an attacker could spawn
    // unreadable conversations (the read rule requires participation) to
    // pollute other users' message indexes or surface adversarial titles in
    // any list view that doesn't filter participants.
    // Admins can delete conversations (Messages page delete feature).
    match /conversations/{convId} {
      allow read:   if isAuth() && uid() in resource.data.participants;
      allow create: if isAuth() &&
                       request.resource.data.participants is list &&
                       uid() in request.resource.data.participants;
      allow update: if isAuth() && uid() in resource.data.participants;
      allow delete: if isAdmin() || (isAuth() && uid() in resource.data.participants);

      match /messages/{msgId} {
        allow read:   if isAuth() && uid() in
          get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        // Sender must self-attribute, and the text is bounded so a single
        // message can't render a multi-KB block in another participant's
        // thread (the UI textarea is already capped; the rule is the gate).
        allow create: if isAuth() && uid() in
          get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
          (!('from' in request.resource.data) || request.resource.data.from == uid()) &&
          (!('text' in request.resource.data) ||
           (request.resource.data.text is string && request.resource.data.text.size() <= 5000));
        allow delete: if isAdmin();
      }
    }

    // ── auditLog ──────────────────────────────────────────────────────────────
    // Reads:
    //   - super_admin: all entries (CRMC oversight of the platform)
    //   - agency_admin: only entries scoped to their own agency. This lets
    //     them satisfy COA-style accountability for their fund usage
    //     without exposing other agencies' operations.
    // Writes: any authenticated user can append, but the actorId MUST equal
    // their auth uid — so an authenticated user can't impersonate a "System"
    // actor or another user by hand-crafting a logAudit body. The earlier
    // version trusted client paths to set actorId honestly, which made the
    // log surface vulnerable to crafted entries (the details field is
    // displayed verbatim in admin/AuditLog and was used as an injection
    // vector against AI agents reviewing the dashboard). The `details`
    // field is bounded at 2000 chars to defang multi-paragraph payloads.
    // Entries are immutable — no updates or deletes ever.
    match /auditLog/{logId} {
      // R33 (§B.26): Activity Timeline reads. Any co-funding agency
      // can read auditLog entries scoped to a request it holds a slice
      // in (entry.requestId matches a request whose agencyIds includes
      // this user's agency). This powers the case timeline on
      // agency/ApplicationDetail. The `requestId` denormalization makes
      // this a single-field check; no expensive multi-doc get() walk.
      //
      // Patient self-read (planned for §B.26 follow-up): a patient can
      // read entries where their uid matches entry.patientId. Surfaces
      // the X-Road citizen-visible audit pattern for RA 10173 §16(c).
      allow read:   if isSuperAdmin() ||
                       (isAgencyAdmin() && resource.data.actorAgencyId == userAgencyId()) ||
                       (isAgency() && resource.data.requestId != null &&
                        userAgencyId() in get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.agencyIds) ||
                       (isAuth() && resource.data.patientId == uid());
      allow create: if isAuth() &&
                       request.resource.data.actorId == uid() &&
                       request.resource.data.details is string &&
                       request.resource.data.details.size() <= 2000;
      allow update, delete: if false;
    }

    // ── notificationErrors ─────────────────────────────────────────────────────
    // Operational log written by the notify() utility when a delivery
    // fails. Without it, delivery failures are invisible until patients
    // complain.
    //
    // Reads: super_admin + staff_admin only — entries can include
    //   recipient UIDs and notification bodies, which are PII-adjacent.
    // Writes: any authenticated user can append (notify() runs from
    //   patient, agency, and admin contexts). The string fields are
    //   bounded so a misconfigured caller — or a malicious one — can't
    //   bury this admin-only collection with multi-KB payloads. The
    //   notify() utility only writes <500 char strings in practice.
    //   Immutable.
    match /notificationErrors/{errorId} {
      allow read:           if isAdmin();
      allow create:         if isAuth() &&
                               (!('title' in request.resource.data) ||
                                (request.resource.data.title is string &&
                                 request.resource.data.title.size() <= 200)) &&
                               (!('body' in request.resource.data) ||
                                (request.resource.data.body is string &&
                                 request.resource.data.body.size() <= 2000)) &&
                               (!('error' in request.resource.data) ||
                                (request.resource.data.error is string &&
                                 request.resource.data.error.size() <= 2000));
      allow update, delete: if false;
    }

    // ── certificates ──────────────────────────────────────────────────────────
    // Patient reads their own certificate.
    // Agency reads certificates they uploaded.
    // Admins read all.
    // Only agencies and admins can upload.
    //
    // resource == null branch: certificates use the applicationId as their
    // docId, so most apps subscribe to a doc that doesn't exist yet (no
    // signed scan uploaded). Allowing reads of non-existent docs lets
    // onSnapshot fire with snap.exists() === false rather than rejecting
    // with permission-denied. No data leak — they can only probe by appId.
    match /certificates/{certId} {
      allow read: if isAuth() && (
        resource == null ||
        resource.data.patientId == uid() ||
        (isAgency() && resource.data.agencyId == userAgencyId()) ||
        isAdmin()
      );
      // Agencies can only write certs scoped to their own agency. Admins
      // can write any (e.g. moving a cert between agencies during a
      // remediation).
      //
      // Phase 0.4 hardening: forge-protection. Without the appId cross-check,
      // an agency could create a certificate for a different agency's
      // application by setting request.resource.data.agencyId to their own
      // but pointing certId at someone else's appId. We now require:
      //   1. request.resource.data.agencyId == userAgencyId() (existing),
      //   2. the underlying application's agencyId also matches (new).
      // certId is the appId (see comment in src/pages/admin/Patients.jsx:334)
      // so the get() chain resolves cleanly.
      allow create: if isAdmin() ||
                       (isAgency() &&
                        request.resource.data.agencyId == userAgencyId() &&
                        get(/databases/$(database)/documents/applications/$(certId)).data.agencyId == userAgencyId());
      allow update: if isAdmin() ||
                       (isAgency() &&
                        request.resource.data.agencyId == userAgencyId() &&
                        resource.data.agencyId == userAgencyId());
      allow delete: if isAdmin();
    }

    // ── docReviewPresence ─────────────────────────────────────────────────────
    // Ephemeral presence tracking for concurrent document review awareness.
    match /docReviewPresence/{docId} {
      allow read, write: if isAdmin();
    }

    // ── documentContents ──────────────────────────────────────────────────────
    // Stores file content separately from metadata for query performance.
    // Document ID matches the corresponding documents/{docId}.
    //
    // Phase 0.2 hardening (post-review): the previous rule let ANY agency
    // (role agency or agency_admin) read EVERY patient's document content,
    // not just contents belonging to documents on cases endorsed to them.
    // Coordinators from Agency A could pull medical PDFs of patients only
    // ever endorsed to Agency B -- Data Privacy Act §16(b) violation.
    //
    // Fix mirrors the documents/{docId} read rule (line 219): cross-check
    // the parent documents metadata's agencyIds[] via a get() chain.
    // Adds one rules-eval get() per content read; acceptable at pilot scale
    // (same pattern used by auditLog at lines 399-404).
    match /documentContents/{docId} {
      allow read:   if isAuth() && (
        resource.data.patientId == uid() ||
        isAdmin() ||
        (isAgency() && userAgencyId() in
          get(/databases/$(database)/documents/documents/$(docId)).data.agencyIds)
      );
      // patientId must match auth so a patient can't write content
      // attributed to another patient. The actual file content goes in a
      // single 'content' string (a base64 data URL); we trust the
      // ~1MB Firestore doc cap to bound size rather than enforce it here.
      // Phase 1.2: cap content size at 1MB on create + update. The 10MiB
      // Storage rule guards the actual file; the Firestore content blob
      // (base64) was bounded only by Firestore's 1MiB doc limit. A
      // malicious admin or patient could push 999 KB blobs repeatedly
      // and inflate read costs. Enforce explicitly so the limit is
      // visible in audit + doesn't depend on Firestore catching it.
      // Phase 1.3: a content blob must have a parent documents/{docId}
      // owned by the SAME patient. Before this, the only create condition
      // was "patientId == my uid", so any authenticated patient could
      // write unlimited documentContents at arbitrary ids with no parent
      // — up to 1MB each, forever. The 2026-06-01 injection incident did
      // exactly that: 12,149 orphan blobs (~236MB) under a single uid,
      // none of which had a documents/{docId} parent. Reads were never
      // exposed (the get() chain below scopes them), but the write side
      // was an unbounded storage/cost sink.
      //
      // Safe for both real write paths, which create the parent FIRST:
      //   uploadPatientDocument  — addDoc(documents) then setDoc(contents)
      //   replacePatientDocument — targets an already-existing docId
      // Admin SDK scripts (seed/migrate) bypass rules entirely.
      //
      // Costs one rules-eval get() per upload, same pattern as the read
      // rule above and auditLog at lines 399-404.
      allow create: if isPatient() &&
                       request.resource.data.patientId == uid() &&
                       exists(/databases/$(database)/documents/documents/$(docId)) &&
                       get(/databases/$(database)/documents/documents/$(docId)).data.patientId == uid() &&
                       (!('content' in request.resource.data) ||
                        (request.resource.data.content is string &&
                         request.resource.data.content.size() <= 1000000));
      allow update: if (isAdmin() ||
                        (isPatient() && resource.data.patientId == uid())) &&
                       (!('content' in request.resource.data) ||
                        (request.resource.data.content is string &&
                         request.resource.data.content.size() <= 1000000));
      allow delete: if isAdmin() || (isPatient() && resource.data.patientId == uid());
    }

    // ── reports ───────────────────────────────────────────────────────────────
    // Reports include both platform-level issue tickets (read/managed by
    // CRMC admins) and intra-agency Budget Requests (read/managed by the
    // requesting agency's agency_admin). The category field distinguishes
    // them; CRMC admins filter Budget Requests out client-side.
    match /reports/{reportId} {
      allow read:   if isAdmin() ||
                       (isAgencyAdmin() && resource.data.agencyId == userAgencyId());
      // Caller must self-attribute (reportedBy == uid()) and the
      // description is bounded — defends the same admin-visible surface
      // from multi-KB or impersonated submissions.
      // Phase 1.3: every guarded field is now REQUIRED, not optional.
      // The previous rule made each check `!('x' in data) || <valid>`, so
      // simply omitting a field skipped its validation — a forged report
      // needed only {category, reportedBy, description} to pass. The
      // 2026-06-01 injection incident wrote 6,481 such docs under one
      // uid. They stayed invisible because the admin Reports view filters
      // on status, which they omitted entirely.
      //
      // Requiring status == 'open' and createdAt == request.time forces
      // creates through the real UI paths (ProfileModals report modal and
      // the agency budget-request modal), both of which always send
      // status:'open' + serverTimestamp(). Pinning createdAt to
      // request.time also stops backdated entries.
      allow create: if isAuth() &&
                       request.resource.data.reportedBy == uid() &&
                       request.resource.data.status == 'open' &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.category is string &&
                       request.resource.data.category.size() > 0 &&
                       request.resource.data.category.size() <= 100 &&
                       request.resource.data.description is string &&
                       request.resource.data.description.size() > 0 &&
                       request.resource.data.description.size() <= 5000;
      allow update: if isAdmin() ||
                       (isAgencyAdmin() && resource.data.agencyId == userAgencyId());
      allow delete: if isAdmin();
    }

    // ── announcements ─────────────────────────────────────────────────────────
    // All authenticated users can read (needed to show banners in Layout).
    // CRMC admins (super/staff) manage ALL announcements. Agency admins may
    // create and manage only their OWN agency-sourced announcements
    // (source == 'agency', matching their agencyId) — these are shown to all
    // patients via the Layout banner.
    match /announcements/{annId} {
      allow read:   if isAuth();
      // Size caps on title/message: announcements render in a Layout
      // banner visible to all users -- a long payload would dominate the
      // viewport. The UI inputs are already maxLength-constrained but the
      // server is the actual gate.
      allow create: if (isAdmin() ||
                       (isAgencyAdmin() &&
                        request.resource.data.source == 'agency' &&
                        request.resource.data.agencyId == userAgencyId())) &&
                       (!('title' in request.resource.data) ||
                        (request.resource.data.title is string &&
                         request.resource.data.title.size() <= 200)) &&
                       (!('message' in request.resource.data) ||
                        (request.resource.data.message is string &&
                         request.resource.data.message.size() <= 2000));
      allow update: if (isAdmin() ||
                       (isAgencyAdmin() &&
                        resource.data.source == 'agency' &&
                        resource.data.agencyId == userAgencyId())) &&
                       (!('title' in request.resource.data) ||
                        (request.resource.data.title is string &&
                         request.resource.data.title.size() <= 200)) &&
                       (!('message' in request.resource.data) ||
                        (request.resource.data.message is string &&
                         request.resource.data.message.size() <= 2000));
      allow delete: if isAdmin() ||
                       (isAgencyAdmin() &&
                        resource.data.source == 'agency' &&
                        resource.data.agencyId == userAgencyId());
    }

    // ── referralSuggestions ──
    // R36 (§B.27): Bonterra warm-handoff pattern. An agency_admin or
    // coordinator at an agency that already holds a slice on a case may
    // suggest that CRMC endorses a SIBLING agency for the same request.
    // CRMC reviews each suggestion -- accept (pre-fills EndorseModal for
    // the target agency) or decline (logs a reason visible to the
    // originating agency). The suggestion does not commit any agency to
    // action; it is an information channel from the ground (agencies)
    // to the network broker (CRMC).
    //
    // Reads:
    //   - admins always
    //   - the originating agency to track their own suggestions
    //   - the target agency to see suggestions directed at them
    // Creates:
    //   - any agency staff for THEIR OWN agency (forgery-resistant)
    //   - status must be 'pending' on create
    //   - reason capped at 1000 chars
    // Updates:
    //   - admins only, status must transition to 'accepted' or 'declined'
    // Deletes:
    //   - never (suggestions are part of the audit trail)
    match /referralSuggestions/{suggestionId} {
      allow read:   if isAuth() && (
                       isAdmin() ||
                       (isAgency() && resource.data.fromAgencyId == userAgencyId()) ||
                       (isAgency() && resource.data.toAgencyId   == userAgencyId())
                     );
      allow create: if isAuth() && isAgency() &&
                       request.resource.data.fromAgencyId == userAgencyId() &&
                       request.resource.data.fromUserId   == uid() &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.reason is string &&
                       request.resource.data.reason.size() <= 1000;
      allow update: if isAdmin() &&
                       request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }
  }
}
