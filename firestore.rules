rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads the current user's role from their Firestore profile.
    // Authenticated users always have a users/{uid} document (created on register/account-create).
    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function userAgencyId() {
      return get(/databases/$(database)/documents/users/$(uid())).data.agencyId;
    }

    function isSuperAdmin() {
      return isAuth() && userRole() == 'super_admin';
    }

    // Covers both super_admin and staff_admin
    function isAdmin() {
      return isAuth() && userRole() in ['super_admin', 'staff_admin'];
    }

    function isAgencyAdmin() {
      return isAuth() && userRole() == 'agency_admin';
    }

    // Convenience: covers both agency_admin (senior agency officer) and
    // agency (coordinator). Most case-handling permissions apply to both.
    function isAgency() {
      return isAuth() && userRole() in ['agency_admin', 'agency'];
    }

    function isPatient() {
      return isAuth() && userRole() == 'patient';
    }

    // ── Network operator (multi-hospital Phase 6) ─────────────────────────────
    // platform_admin runs the network: onboards hospitals + their first admins,
    // owns network config (agencies, reference data). It has NO tenant and NO
    // patient PII — it is deliberately absent from isAdmin(), so every
    // hospital-scoped rule (requests, documents, slices, patients…) denies it.
    // Accounts are created only with the Admin SDK
    // (scripts/create-platform-admin.mjs); no client can mint one.
    function isPlatformAdmin() {
      return isAuth() && userRole() == 'platform_admin';
    }

    function isGatewayStaffRole(role) {
      return role in ['super_admin', 'staff_admin'];
    }

    function isAgencyRoleName(role) {
      return role in ['agency', 'agency_admin'];
    }

    function hospitalExists(tenantId) {
      return exists(/databases/$(database)/documents/hospitals/$(tenantId));
    }

    // ── Agency ↔ hospital partnerships (Phase 7) ───────────────────────────────
    // agencies/{id}.partnerHospitalIds lists the hospitals whose gateways may
    // endorse to that agency (decision D4: the platform admin sets it). An
    // agency onboarded before Phase 7 has no list yet and counts as a partner
    // of hospital #1 only. The default is safe here: it applies to one concrete
    // doc fetched with get(), never to a query's shape.
    function agencyPartners(agencyId) {
      return get(/databases/$(database)/documents/agencies/$(agencyId)).data
               .get('partnerHospitalIds', [defaultTenant()]);
    }

    function partnersWith(agencyId, tenantId) {
      return tenantId in agencyPartners(agencyId);
    }

    // ── Per-hospital access codes (Phase 8) ────────────────────────────────────
    function hospitalDoc(tenantId) {
      return get(/databases/$(database)/documents/hospitals/$(tenantId)).data;
    }

    // A disabled hospital takes no new registrations (its existing patients and
    // staff are unaffected).
    function hospitalOpen(tenantId) {
      return hospitalDoc(tenantId).get('enabled', true) == true;
    }

    // accessCodePrefixes/{PREFIX} names the hospital that owns a prefix. Checked
    // with getAfter so the claim and the hospital doc are written in one batch.
    function prefixHeldBy(prefix, hospitalId) {
      return getAfter(/databases/$(database)/documents/accessCodePrefixes/$(prefix)).data.tenantId == hospitalId;
    }

    // ── Multi-hospital tenancy (Phase 5, docs/multi-hospital-network-plan.md) ──
    // A hospital is the tenant; tenant docs carry `tenantId` (NOT `hospitalId`,
    // which is the patient's access code). Gateway staff and patients reach only
    // their own hospital's records; agencies are network-level and keep their
    // agencyId-based access across hospitals.
    //
    // STRICT ON EXISTING DOCS. Gateway access to an existing doc requires
    // `resource.data.tenantId == the user's tenant` — no default. Rules are
    // checked against a QUERY's filters, and a field the query doesn't filter
    // on reads as absent there, so a default (`get('tenantId', 'hospital-1')`)
    // would make every UNFILTERED admin query pass for hospital #1 and return
    // other hospitals' docs. That leak was reproduced on the emulator
    // (tests/rules/tenantBoundary.rules.test.js "rules are not filters").
    // Consequence: these rules go live only AFTER the Phase 3 backfill, together
    // with VITE_TENANT_SCOPING=true.
    //
    // The default IS used where it's safe — single concrete docs, never query
    // shapes: the signed-in USER (a staff/patient doc without tenantId is
    // hospital #1) and NEW docs being written. MUST equal VITE_DEFAULT_HOSPITAL_ID.
    function defaultTenant() {
      return 'hospital-1';
    }

    // Writes only (request.resource.data, or a doc fetched with get()).
    function tenantOf(data) {
      return data.get('tenantId', defaultTenant());
    }

    // Same users/{uid} doc as userRole(): rules cache identical get()s within
    // one evaluation, so this costs no extra read.
    function userTenantId() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('tenantId', defaultTenant());
    }

    // Strict: the doc must carry the user's tenantId.
    function isHospitalAdmin(data) {
      return isAdmin() && data.tenantId == userTenantId();
    }

    function isHospitalSuperAdmin(data) {
      return isSuperAdmin() && data.tenantId == userTenantId();
    }

    // A new doc is tagged with the writer's own hospital.
    function createsInOwnHospital() {
      return tenantOf(request.resource.data) == userTenantId();
    }

    // Gateway write to an existing doc: it is in the admin's hospital and stays
    // there (moving records between hospitals is a platform action, Phase 6).
    function hospitalAdminWrite() {
      return isHospitalAdmin(resource.data) &&
             request.resource.data.tenantId == resource.data.tenantId;
    }

    // Agency users are network-level (no tenant).
    function isNetworkUserDoc(data) {
      return data.get('role', '') in ['agency', 'agency_admin'];
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Patients own their profile.
    // Admins and agencies can read all users (needed for messaging compose search
    // and for agencies to fetch patient address/hospitalId in the Inbox AppModal).
    //
    // Create split (post seed refactor):
    //   - self-create: userId must equal uid AND role must be 'patient'.
    //     This is the patient registration flow. Self-creating with any
    //     other role would let an attacker mint themselves admin / agency
    //     privileges immediately after createUserWithEmailAndPassword.
    //   - isAdmin: any role, any user. Covers admin/Accounts.jsx which
    //     uses a secondary Firebase app to create new admins/coordinators
    //     while the current admin session writes the user doc.
    //   - isAgencyAdmin: own-agency coordinators only. Covers agency/Team.jsx
    //     where an agency admin adds a new coordinator to their own agency.
    //
    // Seed admin/agency_admin/agency users come from scripts/bootstrap-users.js
    // which uses the Admin SDK and bypasses Firestore rules entirely; the /seed
    // web page no longer self-creates users.
    match /users/{userId} {
      // Read rule additions for the patient compose-message flow:
      //   - Patients can read the gateway admin (super_admin / staff_admin) user
      //     docs so the New Message picker can list them. Without this
      //     the picker silently fails (the original rule treated patients
      //     the same as unauthenticated for cross-user reads, but the
      //     messaging feature has always required the patient to know
      //     who's on the other side).
      //   - Patients can read agency staff (agency / agency_admin) user
      //     docs. Their names + roles are operational, not sensitive --
      //     the patient already sees the agency on their slice and on
      //     /agency catalog pages.
      // Field exposure is still limited to operational fields (name,
      // role, agencyId, email, contact). No password, no PII beyond
      // contact email/phone. Sensitive patient data lives in
      // patients/{uid} which keeps its tighter rule.
      allow read:   if isAuth() && (
        uid() == userId
        || isHospitalAdmin(resource.data)
        // Phase 7: an agency reads a patient only once the gateway has endorsed
        // that patient to it (the endorse transaction adds the agency to the
        // patient's agencyIds). It used to read EVERY user of every hospital.
        || (isAgency() && userAgencyId() in resource.data.get('agencyIds', []))
        || resource.data.role in ['super_admin', 'staff_admin', 'agency', 'agency_admin']
        || (isPlatformAdmin() && resource.data.role == 'platform_admin')
      );
      allow create: if isAuth() && (
        // Self-registration joins the hospital that issued the access code.
        (uid() == userId && request.resource.data.role == 'patient' &&
          tenantOf(request.resource.data) ==
            tenantOf(get(/databases/$(database)/documents/hospitalIds/$(request.resource.data.hospitalId)).data) &&
          // Phase 8: not into a hospital that has stopped registrations.
          hospitalOpen(tenantOf(request.resource.data))) ||
        // Gateway staff create gateway staff in their own hospital (Phase 6:
        // a role allowlist — before it, an admin could mint ANY role, which
        // would include platform_admin). Agency users are network-level and
        // are created by the platform admin or their own agency admin.
        (isAdmin() && isGatewayStaffRole(request.resource.data.role) && createsInOwnHospital()) ||
        // Platform admin onboards a hospital's staff (into an existing
        // hospital) and agency users (no tenant). Never another platform_admin.
        (isPlatformAdmin() &&
          ((isGatewayStaffRole(request.resource.data.role) &&
            'tenantId' in request.resource.data &&
            hospitalExists(request.resource.data.tenantId)) ||
           (isAgencyRoleName(request.resource.data.role) &&
            !('tenantId' in request.resource.data)))) ||
        (isAgencyAdmin() &&
         request.resource.data.agencyId == userAgencyId() &&
         request.resource.data.role in ['agency', 'agency_admin'])
      );
      // Update permissions:
      //   - self: only profile fields. role / agencyId / active / rank are
      //     managed elsewhere — without this, any user could self-promote
      //     to super_admin by writing to their own user doc.
      //   - isAdmin (the gateway super/staff): can edit anything.
      //   - isAgencyAdmin: can edit members of their own agency, but only
      //     within the agency_admin/agency role pair and cannot move them
      //     to a different agency. This lets agency administrators manage
      //     their own coordinators without giving them platform-wide write.
      allow update: if isAuth() && (
        (uid() == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.agencyId == resource.data.agencyId &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.rank == resource.data.rank &&
          // Identity-linking fields are pinned on self-update (abuse hardening
          // #4): a patient must not be able to re-point their hospitalId /
          // patientId at another record, or rename themselves. .get(,null)
          // tolerates roles that lack these fields (staff have no hospitalId).
          // name is pinned for patients only, so staff can still self-rename.
          request.resource.data.get('hospitalId', null) == resource.data.get('hospitalId', null) &&
          request.resource.data.get('patientId', null)  == resource.data.get('patientId', null) &&
          // Multi-hospital Phase 2: tenantId (which hospital the user belongs
          // to — NOT hospitalId, which is the access code) is pinned too. A
          // patient re-pointing it would move their new requests/documents to
          // another hospital. Transfers are an admin action (decision D2).
          request.resource.data.get('tenantId', null)   == resource.data.get('tenantId', null) &&
          (!isPatient() || request.resource.data.get('name', null) == resource.data.get('name', null)) &&
          // Server-owned counters (abuse hardening #3 + #5): only the Admin SDK
          // triggers (onRequestWritten / onDocumentCountChanged, rules-bypassing)
          // write these. Pin them on self-update so a patient can't null their
          // own activeRequestId to unlock a second concurrent request, nor reset
          // documentCount to defeat the upload cap.
          request.resource.data.get('activeRequestId', null) == resource.data.get('activeRequestId', null) &&
          request.resource.data.get('documentCount', 0) == resource.data.get('documentCount', 0) &&
          // Phase 7: which agencies may read this profile is written by the
          // gateway's endorse transaction, never by the patient.
          request.resource.data.get('agencyIds', null) == resource.data.get('agencyIds', null)) ||
        // Gateway staff edit their own hospital's patients and staff — never
        // agency users (network-level, Phase 6) or a platform_admin (which has
        // no tenant, so tenantOf() would default it to hospital #1). A patient
        // stays a patient; staff move only between the two gateway roles; no
        // one moves to another hospital.
        (isAdmin() &&
          resource.data.get('role', '') in ['super_admin', 'staff_admin', 'patient'] &&
          tenantOf(resource.data) == userTenantId() &&
          tenantOf(request.resource.data) == tenantOf(resource.data) &&
          (request.resource.data.role == resource.data.role ||
           (isGatewayStaffRole(resource.data.role) && isGatewayStaffRole(request.resource.data.role)))) ||
        // Platform admin manages staff and agency users, never patients (no
        // PII) or platform admins. Staff can be transferred to another
        // existing hospital (decision D2); agency users stay tenant-less.
        (isPlatformAdmin() &&
          ((isGatewayStaffRole(resource.data.get('role', '')) &&
            isGatewayStaffRole(request.resource.data.role) &&
            hospitalExists(tenantOf(request.resource.data))) ||
           (isAgencyRoleName(resource.data.get('role', '')) &&
            isAgencyRoleName(request.resource.data.role) &&
            !('tenantId' in request.resource.data)))) ||
        (isAgencyAdmin() &&
          resource.data.agencyId == userAgencyId() &&
          resource.data.role in ['agency', 'agency_admin'] &&
          request.resource.data.agencyId == resource.data.agencyId &&
          request.resource.data.get('tenantId', null) == resource.data.get('tenantId', null) &&
          request.resource.data.role in ['agency', 'agency_admin'])
      );
      allow delete: if (isHospitalSuperAdmin(resource.data) &&
                        resource.data.get('role', '') in ['super_admin', 'staff_admin', 'patient']) ||
                       (isPlatformAdmin() &&
                        (isGatewayStaffRole(resource.data.get('role', '')) || isNetworkUserDoc(resource.data)));
    }

    // ── applications ──────────────────────────────────────────────────────────
    // Patients read/create their own applications.
    // Agencies read and update applications for their own agency.
    // Admins read and update all applications.
    match /applications/{appId} {
      allow read: if isAuth() && (
        resource.data.patientId == uid()  ||
        (isAgency() && resource.data.agencyId == userAgencyId()) ||
        // Co-funding: an agency may read every slice of a request it holds a
        // slice in (its id is in the parent request's agencyIds[]). This powers
        // the per-agency co-funding breakdown on the application detail view.
        // The client only surfaces agency name, amount, and status.
        (isAgency() && resource.data.requestId != null &&
          userAgencyId() in get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.agencyIds) ||
        isHospitalAdmin(resource.data)
      );
      // Phase 1.4: admin-only. The rule was `isPatient() || isAdmin()` with
      // NO field validation of any kind, so a signed-in patient could write
      // a slice carrying another patient's patientId, an arbitrary agencyId
      // and amount, and status 'approved' -- forging an approved funding
      // slice that corrupts every agency/admin tally computed off this
      // collection.
      //
      // The isPatient() branch was dead. It was left for "the legacy direct
      // apply flow (still active during the co-funding transition)", but
      // that flow no longer exists: the ONLY write to applications anywhere
      // in src/ is the gateway endorsement transaction in
      // src/pages/admin/Requests.jsx (tx.set on a new slice, status
      // 'endorsed'), which runs as an admin. Every other reference is a
      // read. Patients reach slices through requests, never by creating one.
      // Phase 7: the gateway endorses only to agencies partnered with its hospital.
      allow create: if isAdmin() && createsInOwnHospital() &&
                       partnersWith(request.resource.data.agencyId, tenantOf(request.resource.data));
      allow update: if isAuth() && (
        // Patient can make exactly two transitions on their own application:
        //  1. pending → rejected (self-withdrawal)
        //  2. awaiting_info → reviewing (responding to a "Request More Info"
        //     by uploading a document; the client flips status as part of
        //     the same write)
        // Any other status transition by a patient is denied here.
        (isPatient() && resource.data.patientId == uid() && (
          (resource.data.status == 'pending'       && request.resource.data.status == 'rejected') ||
          (resource.data.status == 'awaiting_info' && request.resource.data.status == 'reviewing') ||
          // Co-funding: patient accepts the coverage plan, advancing their
          // endorsed slice into the agency's review queue.
          (resource.data.status == 'endorsed'      && request.resource.data.status == 'reviewing')
        )) ||
        // Phase 1.6: an agency may write its own slice, but the identity +
        // endorsement fields are LOCKED — they can't reassign the slice to
        // another patient/agency/request or inflate the gateway-endorsed cap.
        // Everything else (the funding decision: status, amountApproved,
        // glStatus, approvedBy, cooldown, purposeOfAssistance, payableTo,
        // signedScan pointer, timestamps, …) stays writable, so no legitimate
        // approve / reverse / GL / redeem flow is affected. This is a locked-
        // immutables guard rather than a field allowlist precisely so it can't
        // silently break one of those multi-field transitions.
        // amountApproved (the agency's decision) stays writable but is CAPPED
        // at amountRequested (the gateway's endorsed cap, itself locked). Without the
        // cap an agency could approve MORE than the gateway endorsed via a direct
        // write, over-committing the request past its need (double-funding) —
        // syncRequestFinancials would then faithfully sum the inflated figure.
        // Guarded so non-approval updates that don't carry amountApproved
        // (needs_info, reject) still pass.
        (isAgency() && resource.data.agencyId == userAgencyId() &&
          request.resource.data.patientId      == resource.data.patientId &&
          request.resource.data.agencyId       == resource.data.agencyId &&
          request.resource.data.requestId      == resource.data.requestId &&
          request.resource.data.amountRequested == resource.data.amountRequested &&
          (!('amountApproved' in request.resource.data) ||
            request.resource.data.amountApproved <= resource.data.amountRequested)) ||
        hospitalAdminWrite()
      );
      allow delete: if isHospitalAdmin(resource.data);
    }

    // ── requests ────────────────────────────────────────────────────────────
    // Co-funding parent: the patient's medical-assistance need + amount. the gateway
    // verifies it, then splits it into child application "slices" and endorses
    // them toward zero balance. Patients own and read their own request and may
    // withdraw it while still 'submitted'. the gateway admins manage all. An agency
    // can read a request only if it holds a slice in it (its id is in
    // agencyIds[]), and may update ONLY the funding tally fields when recording
    // an approval against its slice — never patient data, the target amount, or
    // the agency list. (The applications/create rule still gates slice creation
    // to the gateway at cutover; this block is additive and does not change the
    // existing apply flow.)
    match /requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.patientId == uid() ||
        isHospitalAdmin(resource.data) ||
        (isAgency() && userAgencyId() in resource.data.agencyIds)
      );
      // Phase 1.4: pin the entry state. Ownership was already enforced, but
      // nothing stopped a patient creating their own request pre-advanced to
      // 'fully_funded'/'endorsed', or pre-loaded with agencyIds -- i.e.
      // self-endorsing past the gateway verification, which is the whole point of
      // the gateway. Mirrors documents.create, which already pins status and
      // blocklists agencyIds. Verified against the only create site,
      // src/pages/patient/RequestAssistance.jsx, which sends exactly
      // status:'submitted', agencyIds:[], amountCommitted:0.
      // Abuse hardening #3 — one active request per patient. A patient works
      // one bill toward zero balance at a time, so block a new request while
      // they already have a non-terminal one. Rules can't query/aggregate, so
      // the onRequestWritten trigger mirrors the state into
      // users/{uid}.activeRequestId and this rule reads it with a single get()
      // (default null so a patient with none — the normal case — passes). The
      // trigger clears the pointer when the request goes terminal/withdrawn.
      allow create: if isPatient() &&
                       request.resource.data.patientId == uid() &&
                       createsInOwnHospital() &&
                       request.resource.data.status == 'submitted' &&
                       request.resource.data.agencyIds == [] &&
                       request.resource.data.amountCommitted == 0 &&
                       get(/databases/$(database)/documents/users/$(uid()))
                         .data.get('activeRequestId', null) == null;

      // Revision 9 — the applicant's answers belong to the applicant. Gateway
      // staff may change anything else on the request (status, assessment,
      // verification, lock), but NOT the patient FACT keys of intakeSheet —
      // they verify them or send them back for correction. The one exception
      // is encoding on behalf of a patient who has never filled the sheet
      // (no patientFilledAt), which must carry encodedOnBehalf with the
      // writer's uid and a reason. Keep intakeFactKeys() in sync with
      // PATIENT_FACT_KEYS in src/utils/intakeSheet.js.
      function intakeFactKeys() {
        return ['familyMembers', 'householdSize', 'monthlyIncome', 'employmentType',
                'employmentTypeOther', 'employer', 'lengthOfEmployment', 'incomeSource',
                'expenses', 'shortfallCoverage', 'shortfallCoverageOther',
                'diagnosis', 'attendingPhysician', 'dateOfAdmission', 'estimatedTotalCost'];
      }
      function staffIntakeWriteOk() {
        let before = resource.data.get('intakeSheet', {});
        let after  = request.resource.data.get('intakeSheet', {});
        return !after.diff(before).affectedKeys().hasAny(intakeFactKeys()) ||
          (!before.keys().hasAny(['patientFilledAt']) &&
           after.get('encodedOnBehalf', {}).get('byUid', '') == uid() &&
           after.encodedOnBehalf.get('reason', '') is string &&
           after.encodedOnBehalf.reason.size() >= 10);
      }

      allow update: if (hospitalAdminWrite() && staffIntakeWriteOk()) ||
        (isPatient() && resource.data.patientId == uid() &&
          resource.data.status == 'submitted' &&
          request.resource.data.status == 'closed') ||
        // Patient fills the factual portion of their own intake sheet (the
        // the gateway assessment fields are written by admins). Only the intakeSheet
        // field may change via this path.
        //
        // Within intakeSheet the patient may change ONLY the factual keys. The
        // whole map used to be writable, so a patient could set their own
        // meansTestCategory / recommendation / completedBy and make the
        // assessment look complete — the endorse gate. Assessment + audit keys
        // (meansTestCategory, meansTestOverrideReason, recommendation,
        // caseStudyNarrative, hospitalCaseNumber, completedBy/At,
        // lastEditedBy/At) are gateway-only. diff() against the stored map (or
        // {} before the first save) so carrying existing values through is fine.
        //
        // Once the social worker completes the assessment the sheet is LOCKED
        // (intakeSheet.factsLocked == true, set by staff only — not in the
        // allowlist below), so the facts the assessment was based on can't
        // change underneath it. Staff can unlock to allow a correction.
        (isPatient() && resource.data.patientId == uid() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['intakeSheet', 'updatedAt']) &&
          resource.data.get('intakeSheet', {}).get('factsLocked', false) != true &&
          request.resource.data.intakeSheet is map &&
          request.resource.data.intakeSheet.diff(resource.data.get('intakeSheet', {})).affectedKeys()
            .hasOnly([
              'familyMembers', 'householdSize', 'monthlyIncome', 'employmentType',
              'employmentTypeOther', 'employer', 'lengthOfEmployment', 'incomeSource',
              'expenses', 'shortfallCoverage', 'shortfallCoverageOther',
              'diagnosis', 'attendingPhysician', 'dateOfAdmission',
              'estimatedTotalCost', 'patientFilledAt'
            ])) ||
        // Phase 1.5: hasOnly limited WHICH fields an agency may touch but not
        // WHAT it may write, so an agency holding one slice could set status
        // to any string -- including the gateway-only states like 'under_review',
        // 'assessment' or 'closed' -- and amountCommitted to a non-number or
        // a negative. Constrain both to what the real path can produce:
        // deriveRequestStatus() in src/utils/requests.js returns exactly this
        // four-value set, and amountCommitted is always a non-negative sum of
        // approved slices.
        //
        // LIMITATION: this does NOT stop an agency writing an inflated but
        // well-formed amountCommitted. Rules cannot re-derive the sum over
        // sibling slices, so verifying that figure needs a Cloud Function.
        (isAgency() && userAgencyId() in resource.data.agencyIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['amountCommitted', 'status', 'updatedAt']) &&
          request.resource.data.amountCommitted is number &&
          request.resource.data.amountCommitted >= 0 &&
          request.resource.data.status in
            ['submitted', 'endorsed', 'partially_funded', 'fully_funded']);
      allow delete: if isHospitalAdmin(resource.data);
    }

    // ── documents ─────────────────────────────────────────────────────────────
    // Patients own their documents.
    // Agencies can read all patient documents (needed for application review).
    // Admins can read and update (verification status).
    match /documents/{docId} {
      // Agency reads are scoped to documents on requests they hold a slice
      // for. The endorse transaction (admin/Requests EndorseModal) stamps
      // an agencyIds[] array onto each attached document at endorse time,
      // and the /seed-page backfill stamped pre-existing legacy docs.
      //
      // R9 (2026-06-03): split into three allow read statements so each
      // is evaluated independently by Firestore's query-rule analyzer.
      // The original combined-OR clause + `is list` defensive check
      // confused the analyzer on the agency-side LIST query
      // `where('agencyIds', 'array-contains', userAgencyId)` -- the
      // analyzer couldn't determine that `array-contains` aligned with
      // the rule's `in` operator, so the query was denied even though
      // every individual result document would pass the rule. The
      // simpler single-clause form below works because the analyzer
      // can match `array-contains` directly against `in` without
      // intervening conjunctions.
      allow read: if isAuth() && resource.data.patientId == uid();
      allow read: if isHospitalAdmin(resource.data);
      allow read: if isAgency() && userAgencyId() in resource.data.agencyIds;
      // Patient creates own document. patientId must match auth (no creating
      // docs attributed to other patients), status must start at 'pending'
      // (can't pre-stamp verified to bypass the gateway review), agencyIds[]
      // can't be pre-stamped (admins set this at endorse time, granting
      // agency read access), and storagePath cannot be present at create
      // time (it's stamped via update AFTER the actual Storage upload
      // succeeds -- pre-stamping a path that points elsewhere would let
      // the viewer load attacker-chosen Storage objects under the docId).
      // The OCR text from uploadDocument.js is already sliced to 2000 chars
      // client-side; we bound it server-side too.
      //
      // Advisory ID-verification fields (idTypeDetected + on-device face-match /
      // liveness flags & scores — see docs/id-verification-plan.md). These are
      // hints for the gateway verifier, never authoritative, but a hostile client
      // must not be able to write junk into the audit trail, so bound each:
      // verdicts to their enum (or null), scores to a number in [0,1] (or null),
      // the detected type to a short string. NEVER a face template.
      // Phase 3 (PhilSys-first identity) adds advisory National-ID metadata on the
      // ID doc. NEVER the raw PCN/PSN: only a masked PCN (last 4 digits as a short
      // string), a KEYED fingerprint (HMAC hex, never reversible to the PCN), the
      // name/DOB read from the QR, and whether the PSA signature verified. All
      // advisory; the social worker confirms. 'pcn_manual' is the typed-fallback
      // method. Bound each so a hostile client can't write junk into the record:
      //   pcnLast4       short string (masked, e.g. "3456")
      //   pcnFingerprint hex string <= 64 (HMAC-SHA256 hex)
      //   philIdName     string <= 200
      //   philIdDob      string <= 40
      //   philIdSigValid bool or null (null = unverified / no key)
      function verifyFieldsOk(d) {
        return (!('idTypeDetected' in d) || (d.idTypeDetected is string && d.idTypeDetected.size() <= 100))
          && (!('faceMatch' in d)      || d.faceMatch == null      || d.faceMatch in ['pass', 'unclear'])
          && (!('liveness' in d)       || d.liveness == null       || d.liveness in ['pass', 'unclear'])
          && (!('idVerifyMethod' in d) || d.idVerifyMethod == null  || d.idVerifyMethod in ['ocr', 'philid_qr', 'pcn_manual'])
          && (!('faceMatchScore' in d) || d.faceMatchScore == null || (d.faceMatchScore is number && d.faceMatchScore >= 0 && d.faceMatchScore <= 1))
          && (!('livenessScore' in d)  || d.livenessScore == null  || (d.livenessScore is number && d.livenessScore >= 0 && d.livenessScore <= 1))
          // Advisory screen/photo-recapture heuristic (selfie docs). A weak,
          // never-blocking hint to the social worker that the "live" selfie may
          // be a photo of a screen/print; the camera-only capture + human
          // confirmation remain the real control. Score 0..1 + a suspected flag.
          && (!('recaptureScore' in d)     || d.recaptureScore == null || (d.recaptureScore is number && d.recaptureScore >= 0 && d.recaptureScore <= 1))
          && (!('recaptureSuspected' in d) || d.recaptureSuspected == null || d.recaptureSuspected is bool)
          && (!('pcnLast4' in d)       || d.pcnLast4 == null       || (d.pcnLast4 is string && d.pcnLast4.size() <= 24))
          && (!('pcnFingerprint' in d) || d.pcnFingerprint == null || (d.pcnFingerprint is string && d.pcnFingerprint.size() <= 64))
          && (!('philIdName' in d)     || d.philIdName == null     || (d.philIdName is string && d.philIdName.size() <= 200))
          && (!('philIdDob' in d)      || d.philIdDob == null      || (d.philIdDob is string && d.philIdDob.size() <= 40))
          && (!('philIdSigValid' in d) || d.philIdSigValid == null || d.philIdSigValid is bool)
          && (!('ocrConfidence' in d)  || d.ocrConfidence == null  || (d.ocrConfidence is number && d.ocrConfidence >= 0 && d.ocrConfidence <= 100))
          // appearanceNote: an OPTIONAL patient-written note explaining why their
          // live selfie may not match the ID (recent surgery, injury, bandages,
          // illness). Advisory context for the social worker, never a gate. Bound
          // the free text so a hostile client can't write junk into the record.
          && (!('appearanceNote' in d) || d.appearanceNote == null || (d.appearanceNote is string && d.appearanceNote.size() <= 500));
      }
      // Abuse hardening #5 — cap the NUMBER of documents a patient can upload.
      // File size is already bounded (~650 KB); this bounds the count, since each
      // doc's bytes live as base64 in documentContents. Rules can't count a
      // collection, so onDocumentCountChanged mirrors the total into
      // users/{uid}.documentCount (+1 create / -1 delete) and this reads it with
      // one get(). 60 is a generous lifetime ceiling (~8-10 requests' worth of
      // checklist docs) — an abuse cap, not a tight quota; raise if a real
      // long-lived patient ever approaches it.
      allow create: if isPatient() &&
                       request.resource.data.patientId == uid() &&
                       createsInOwnHospital() &&
                       request.resource.data.status == 'pending' &&
                       !('agencyIds' in request.resource.data) &&
                       !('storagePath' in request.resource.data) &&
                       (!('ocrText' in request.resource.data) ||
                        (request.resource.data.ocrText is string &&
                         request.resource.data.ocrText.size() <= 4000)) &&
                       verifyFieldsOk(request.resource.data) &&
                       get(/databases/$(database)/documents/users/$(uid()))
                         .data.get('documentCount', 0) < 60;
      // gateway redesign: document verification is the gateway's job (the single
      // intake gateway), so only admins verify/reject. Agencies keep READ for
      // the funding decision but no longer write document status. Patients may
      // re-upload their own (status reset handled by replacePatientDocument).
      // Phase 1.5: the create rule above pins status 'pending' and blocklists
      // agencyIds + storagePath -- but update had NO field constraints at all,
      // so every one of those guards was bypassable with a follow-up write:
      //
      //   1. create {status:'pending'}   -> passes create
      //   2. update {status:'verified'}  -> patient self-verifies their own
      //      ID / indigency documents, defeating the social-worker
      //      verification gate the whole intake model rests on.
      //   3. update {storagePath:'...'}  -> exactly the attack the create
      //      rule's comment says it prevents (viewer loads an
      //      attacker-chosen Storage object under this docId).
      //   4. update {agencyIds:[...]}    -> self-endorse the doc to arbitrary
      //      agencies, which also grants them documentContents read access
      //      via the get() chain on this doc.
      //
      // Patients keep exactly the re-upload path. Verified against the only
      // client-side patient write, replacePatientDocument in
      // src/utils/uploadDocument.js, which sets precisely these keys and
      // always resets status to 'pending' for re-review.
      allow update: if hospitalAdminWrite() ||
                       (isPatient() && resource.data.patientId == uid() &&
                        request.resource.data.status == 'pending' &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'fileName', 'type', 'size', 'date',
                                    'reviewedBy', 'reviewedAt', 'ocrText', 'ocrMatch', 'ocrConfidence',
                                    'idTypeDetected', 'faceMatch', 'faceMatchScore',
                                    'liveness', 'livenessScore', 'idVerifyMethod',
                                    'pcnLast4', 'pcnFingerprint', 'philIdName',
                                    'philIdDob', 'philIdSigValid', 'appearanceNote',
                                    'recaptureScore', 'recaptureSuspected']) &&
                        (!('ocrText' in request.resource.data) ||
                         (request.resource.data.ocrText is string &&
                          request.resource.data.ocrText.size() <= 4000)) &&
                        verifyFieldsOk(request.resource.data));
      // Patient deletes are narrowed to the rollback case. The only
      // patient-side deleteDoc on documents is uploadPatientDocument's
      // rollback when the content write fails -- at that point the doc is
      // freshly created, still 'pending', and has no agencyIds. Without
      // these conditions a patient could delete a VERIFIED, already-endorsed
      // document mid-review to destroy the evidence behind a funding
      // decision.
      allow delete: if isHospitalAdmin(resource.data) ||
                       (isPatient() && resource.data.patientId == uid() &&
                        resource.data.status == 'pending' &&
                        !('agencyIds' in resource.data));
    }

    // ── agencies ──────────────────────────────────────────────────────────────
    // Public read — landing page shows available programs to unauthenticated visitors.
    // Updates split by authority:
    //   - the gateway admin (super/staff): operational fields (name, enabled, slots,
    //     contact info, defaultSignatory, assistanceTypes, etc.) — but NOT
    //     budget.allocated / budget.committed / budget.disbursed.
    //   - agency_admin: own agency only. Can write budget fields (the
    //     allocation authority), plus the same operational fields.
    //   - agency coordinator: own agency only. Slots and similar low-impact
    //     operational fields (UI controls limit them to slot management today).
    // Field-level constraints are enforced in the client UI; the rules here
    // give the broad write permission. A tighter field-level guard can be
    // added later (request.resource.data.budget == resource.data.budget for
    // the gateway admin) once the UI gating is fully verified.
    // The rich agency doc carries budget (allocated / committed / disbursed),
    // fundSource, contacts and signatories. It was world-readable (`if true`)
    // only so the public Landing page could show a live programs teaser — which
    // leaked every partner's internal budget to the internet (audit SEC-3). The
    // teaser now reads the non-sensitive `agenciesPublic` projection below, so
    // this collection is gated to authenticated principals. Every in-app reader
    // (admin/agency surfaces, LiveDataContext) is already authenticated.
    match /agencies/{agencyId} {
      allow read:   if isAuth();
      // Phase 6: agencies are network config — the platform admin onboards,
      // edits and removes them. Hospital admins keep only the slot counters
      // their endorse transaction and the daily slot-reset fallback write
      // (admin/Requests.jsx); they can't change slots.total, enabled, or
      // anything else.
      allow create: if isPlatformAdmin();
      // Update authority split:
      //   - the gateway admin: anything (operational fields + emergency budget
      //     overrides during incident response).
      //   - agency_admin: own agency. Allowed to write budget.* because
      //     they are the allocation authority for their own fund source.
      //   - agency coordinator (role=='agency'): own agency, but the
      //     budget object must stay byte-identical. This prevents an
      //     authenticated coordinator from calling the Firestore SDK
      //     directly to inflate budget.allocated past whatever the UI
      //     gate enforces -- the previous version trusted the client
      //     for that.
      // Coordinator update rule (hotfix from prod):
      //   - The original rule required the entire budget object to be
      //     byte-identical, which blocked the GL-expiry sweep on the
      //     agency dashboard (it mutates `budget.committed` to release
      //     funds when a coordinator-issued GL lapses). Symptom in prod:
      //     "GL expiry sweep failed: Missing or insufficient permissions"
      //     on every coordinator dashboard load with at least one
      //     expired GL.
      //   - The threat the original rule guards is "coordinator inflates
      //     budget.allocated past the UI limit." That threat is
      //     preserved by pinning `allocated` and `fundSource` only.
      //     Usage-tracking fields (committed, disbursed, totalSpent)
      //     are allowed to change so automated transaction flows
      //     (GL expire, approval, redeem) work for non-admin agency
      //     coordinators.
      allow update: if isPlatformAdmin() ||
                       (isAdmin() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'lastResetDate']) &&
                        request.resource.data.get('slots', {}).get('total', 0) == resource.data.get('slots', {}).get('total', 0)) ||
                       // Phase 7: agency staff can't change their own partner
                       // hospitals (D4 — the platform admin sets them).
                       (isAgencyAdmin() && userAgencyId() == agencyId &&
                        request.resource.data.get('partnerHospitalIds', null) == resource.data.get('partnerHospitalIds', null)) ||
                       (isAgency() && !isAgencyAdmin() && userAgencyId() == agencyId &&
                        request.resource.data.get('partnerHospitalIds', null) == resource.data.get('partnerHospitalIds', null) &&
                        request.resource.data.budget.allocated == resource.data.budget.allocated &&
                        // .get(field, default) lets the rule tolerate
                        // budgets where fundSource hasn't been set yet
                        // (default null on both sides means equality holds);
                        // without it, the rule errors on the undefined-property
                        // access and denies the write.
                        request.resource.data.budget.get('fundSource', null) == resource.data.budget.get('fundSource', null));
      allow delete: if isPlatformAdmin();
    }

    // ── agenciesPublic ──────────────────────────────────────────────────────────
    // A non-sensitive projection of each agency (name + slots + enabled only).
    // World-readable so the public Landing page can show its live programs teaser
    // without exposing the rich `agencies` doc (budget / fundSource / contacts /
    // signatories).
    //
    // Authoritative writer is the onAgencyWritten Cloud Function (Admin SDK,
    // bypasses rules) — but it is NOT deployed on the live project, so the client
    // mirrors this projection from every agency-write path (src/utils/
    // agenciesPublic.js), the same belt-and-suspenders pattern as the client-side
    // daily slot reset. Writers are therefore the exact principals allowed to
    // edit the source agencies/{id} doc (the gateway admin, or any agency role on its
    // own agency), and the payload is pinned to ONLY the four projected fields —
    // so this can never become a budget/contact leak even from a hostile client.
    match /agenciesPublic/{agencyId} {
      allow read:  if true;
      allow write: if (isPlatformAdmin() || isAdmin() || (isAgency() && userAgencyId() == agencyId))
                      && request.resource.data.keys().hasOnly(['name', 'initials', 'color', 'location', 'enabled', 'slots', 'updatedAt'])
                      && request.resource.data.slots.keys().hasOnly(['total', 'remaining']);
      allow delete: if isPlatformAdmin();
    }

    // ── documentTypes ─────────────────────────────────────────────────────────
    // All authenticated users can read (patients see requirements during apply).
    // Network config: only the platform admin can modify (Phase 6).
    match /documentTypes/{typeId} {
      allow read:  if isAuth();
      allow write: if isPlatformAdmin();
    }

    // ── assistanceTypes ───────────────────────────────────────────────────────
    match /assistanceTypes/{typeId} {
      allow read:  if isAuth();
      allow write: if isPlatformAdmin();
    }

    // ── hospitals ─────────────────────────────────────────────────────────────
    // Multi-hospital tenancy, Phase 1 (docs/multi-hospital-network-plan.md).
    // One doc per hospital (tenant): branding/contact config that AuthContext
    // applies to ORG at sign-in. No PII, so any signed-in user may read (every
    // role needs its own hospital's names on screen). Writes: super_admin only
    // until platform_admin exists (Phase 6). Keys are pinned so the doc can't
    // become a dumping ground for data the readable-by-all rule would expose.
    match /hospitals/{hospitalId} {
      allow read:  if isAuth();
      // create/update only — rules OR together, so `allow write` would also
      // grant delete. Deleting a tenant is never a client action.
      // Phase 6: the platform admin creates hospitals and edits any of them.
      // A hospital's own super admin edits only its BRANDING — not the
      // access-code prefix (globally unique, decides which hospital a patient
      // joins) and not `enabled` (network decisions).
      // Phase 8: a hospital may only carry a prefix it holds the claim to
      // (accessCodePrefixes below) — server-side prefix uniqueness (D5).
      allow create: if isPlatformAdmin() && hospitalKeysOk() &&
                      (!('accessCodePrefix' in request.resource.data) ||
                       prefixHeldBy(request.resource.data.accessCodePrefix, hospitalId));
      allow update: if hospitalKeysOk() && (
                      isPlatformAdmin() ||
                      (isSuperAdmin() && hospitalId == userTenantId() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'shortName', 'gatewayName', 'gatewayInitials', 'facilityName',
                         'contactEmail', 'address', 'logoUrl', 'updatedAt'
                       ]))) &&
                      (!('accessCodePrefix' in request.resource.data) ||
                       request.resource.data.accessCodePrefix == resource.data.get('accessCodePrefix', '') ||
                       prefixHeldBy(request.resource.data.accessCodePrefix, hospitalId));
    }

    // ── networkStats ───────────────────────────────────────────────────────────
    // Phase 9. Per-hospital counts (no patient data) for the platform admin's
    // Network page — computed by the Admin SDK (refreshNetworkStats /
    // scripts/compute-network-stats.mjs) because the platform admin may not
    // read the records being counted. No client writes.
    match /networkStats/{statId} {
      allow read:  if isPlatformAdmin();
      allow write: if false;
    }

    // ── accessCodePrefixes ─────────────────────────────────────────────────────
    // Phase 8. One doc per access-code prefix ever used, naming its hospital.
    // Access codes live in ONE namespace (hospitalIds/{code}), so two hospitals
    // sharing a prefix would collide; a claim is created once by the platform
    // admin and never changed or deleted — a retired prefix stays reserved
    // because codes issued under it still exist. Readable by any signed-in user
    // (prefixes are printed on every code card).
    match /accessCodePrefixes/{prefix} {
      allow read:   if isAuth();
      allow create: if isPlatformAdmin() &&
                       prefix.matches('[A-Z][A-Z0-9]{1,9}') &&
                       request.resource.data.keys().hasOnly(['tenantId', 'createdAt']) &&
                       getAfter(/databases/$(database)/documents/hospitals/$(request.resource.data.tenantId)).data
                         .get('accessCodePrefix', '') == prefix;
      allow update, delete: if false;
    }

    function hospitalKeysOk() {
      return request.resource.data.keys().hasOnly([
               'shortName', 'gatewayName', 'gatewayInitials', 'facilityName',
               'contactEmail', 'accessCodePrefix', 'address', 'logoUrl',
               'enabled', 'createdAt', 'updatedAt'
             ]);
    }

    // ── hospitalIds ───────────────────────────────────────────────────────────
    // Single-document GET requires authentication. Registration never reads a
    // code unauthenticated: Register.jsx signs the user in anonymously before
    // the verify step, and the atomic claim runs a `tx.get` after the real
    // account is created (createUserWithEmailAndPassword) -- both are isAuth().
    // Agencies get() the parent to read cooldown fields at approval; admins
    // manage codes. Closing the previous `allow get: if true` removes the
    // unauthenticated code-existence probe (NFR-04 deny-by-default); the parent
    // carries no PII (the patient name lives behind the auth-gated privateInfo
    // sub-collection, and patId is an opaque uid). An anon-authenticated probe
    // is still possible in principle -- fully closing that needs the claim
    // moved server-side, tracked as future work.
    // Listing all IDs requires authentication.
    // Updates:
    //   - admin: anything (manual reset, status changes)
    //   - patient (registration claim): isAuth() rather than isPatient()
    //     because the patient's user doc is created in the SAME transaction
    //     as this hospitalIds update during registration. Firestore rules
    //     cannot see pending writes from the same transaction, so an
    //     isPatient() check (which does get(users/uid).role) would return
    //     false against the not-yet-committed user doc and fail the whole
    //     transaction with permission-denied. The field-level constraints
    //     (status must currently be 'available', must flip to 'used',
    //     patId must equal the requesting uid) carry the security here
    //     without needing the role lookup.
    // Only super_admin can create or delete IDs.
    match /hospitalIds/{hospitalId} {
      // get stays open to any signed-in user: registration verifies a code
      // (anonymous auth) before the patient has a hospital. Listing the codes
      // is the gateway's job, scoped to its own hospital.
      allow get:    if isAuth();
      allow list:   if isHospitalAdmin(resource.data);
      // Phase 8: a hospital issues codes only under its own prefix, so codes
      // from different hospitals can never collide in this one namespace.
      allow create: if isSuperAdmin() && createsInOwnHospital() &&
                       hospitalId.matches(hospitalDoc(tenantOf(request.resource.data)).get('accessCodePrefix', '') +
                                          '-[0-9]{4}-[0-9]{5}');
      allow update: if hospitalAdminWrite() ||
                       // Phase 1.5: the claim branch pinned status and patId
                       // but left every OTHER field on the doc writable in
                       // the same operation -- a registering user could
                       // rewrite arbitrary fields on a hospitalIds doc while
                       // legitimately claiming it. Restricted to the four
                       // keys the registration transaction actually writes
                       // (src/pages/auth/Register.jsx).
                       (isAuth() &&
                        resource.data.status == 'available' &&
                        request.resource.data.status == 'used' &&
                        request.resource.data.patId == uid() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'patId', 'date', 'time'])) ||
                       // #9 — Agencies (and agency admins) may stamp the
                       // cooldown fields when approving or reversing an
                       // approval, but cannot touch status / usedBy / patId.
                       // Tracking cooldown here (keyed by the human's the gateway
                       // ID, not by the per-account UID) makes the 30-day
                       // lock survive account-deletion + re-registration.
                       (isAgency() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cooldownUntilAt', 'lastApprovedAt']));
      allow delete: if isHospitalSuperAdmin(resource.data);

      // Phase 0.3 hardening (post-review): the patient NAME used to live on
      // the parent hospitalIds doc as `usedBy`, but the parent allows
      // unauthenticated GET (needed during registration verification --
      // patient is not yet logged in). That made every claimed code's
      // patient name publicly enumerable. Names + access codes are a
      // ready-made phishing kit.
      //
      // Fix: move the name to this sub-collection. By convention the
      // single doc per parent is keyed `details`, so admin code does one
      // get() per row instead of a query. The parent retains `patId`
      // (a uid — 28 random chars, doesn't enumerate, doesn't phish) so
      // the existing claim-transaction rule (line 320) keeps working.
      match /privateInfo/{infoId} {
        // Admins read all; the claimant patient reads their own (parent
        // doc's patId must equal the requesting uid). Agencies do NOT
        // need patient names from this collection -- they get them from
        // the users/{uid} doc via the application's patientId.
        allow read:   if isHospitalAdmin(get(/databases/$(database)/documents/hospitalIds/$(hospitalId)).data) ||
                         (isAuth() &&
                          get(/databases/$(database)/documents/hospitalIds/$(hospitalId)).data.patId == uid());
        // Create runs inside the registration claim transaction. Patient
        // user doc doesn't yet exist at that moment (same-transaction
        // limitation; see parent-update comment above for why isPatient()
        // fails here). isAuth() + self-attribution via usedById carries
        // the security.
        allow create: if isAuth() &&
                         request.resource.data.usedById == uid() &&
                         request.resource.data.usedBy is string &&
                         request.resource.data.usedBy.size() <= 120;
        allow update: if isHospitalAdmin(get(/databases/$(database)/documents/hospitalIds/$(hospitalId)).data);
        allow delete: if isHospitalAdmin(get(/databases/$(database)/documents/hospitalIds/$(hospitalId)).data);
      }
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Only the owner can read and manage their notifications.
    // Any authenticated user can create a notification for any user (needed for
    // cross-role notifications: agency notifies patient, admin notifies agency,
    // etc.). Title and body are bounded so a malicious authenticated client
    // can't push a multi-KB payload (phishing copy, prompt-injection text)
    // into another user's notification panel.
    match /notifications/{userId}/items/{notifId} {
      allow read:   if isAuth() && uid() == userId;
      // Phase 1.4: require sender attribution. read/update/delete all check
      // uid() == userId, but create checked ONLY isAuth() -- the {userId}
      // path segment was never compared to the caller, so any patient could
      // drop a notification into a super_admin's feed, with no sender field
      // required. That is a spoofing primitive aimed at the highest-privilege
      // users, and it is the same surface the 2026-06-01 injection used
      // (planted records written to manipulate whoever reads the dashboard).
      // The size caps this rule already had bound the payload but do nothing
      // about forgery.
      //
      // Cross-role creation must stay open (agency -> patient, admin ->
      // agency, patient -> admin on request submit), so uid() == userId is
      // NOT the fix. Mandatory fromUid makes every notification traceable to
      // the account that wrote it.
      //
      // LIMITATION, stated plainly: this makes forgery attributable, not
      // impossible. A patient can still write a truthful-looking fromUid of
      // their own and phish an admin. Closing it completely means moving
      // notification writes into a Cloud Function so clients never touch
      // this collection -- the functions codebase already exists.
      // Abuse hardening #1: a PATIENT may only create a notification addressed to
      // themselves — they can no longer drop notifications into staff feeds (the
      // spam / phishing primitive). The one legitimate patient->staff signal (a
      // new request submitted) is now produced server-side by the
      // onRequestCreated Cloud Function. Staff/agency keep cross-user create.
      allow create: if isAuth() &&
                       request.resource.data.fromUid == uid() &&
                       (!isPatient() || userId == uid()) &&
                       (!('title' in request.resource.data) ||
                        (request.resource.data.title is string &&
                         request.resource.data.title.size() <= 200)) &&
                       (!('body' in request.resource.data) ||
                        (request.resource.data.body is string &&
                         request.resource.data.body.size() <= 2000));
      allow update: if isAuth() && uid() == userId;
      allow delete: if isAuth() && uid() == userId;
    }

    // ── conversations ─────────────────────────────────────────────────────────
    // Only participants can read and write a conversation and its messages.
    // Any authenticated user can create a conversation, but they MUST list
    // themselves in participants — otherwise an attacker could spawn
    // unreadable conversations (the read rule requires participation) to
    // pollute other users' message indexes or surface adversarial titles in
    // any list view that doesn't filter participants.
    // Admins can delete conversations (Messages page delete feature).
    match /conversations/{convId} {
      allow read:   if isAuth() && uid() in resource.data.participants;
      // Abuse hardening #2 (reply-only messaging): patients cannot START a
      // conversation — only staff/agency initiate (the admin "Message patient"
      // action already does). Patients remain participants and keep read +
      // messages.create (reply). Kills the patient compose spam + the
      // recipient-picker "message anyone" surface.
      allow create: if isAuth() &&
                       request.resource.data.participants is list &&
                       uid() in request.resource.data.participants &&
                       !isPatient();
      // Phase 1.5: participants is now immutable via this path. The rule
      // let any participant rewrite the array, so one party could silently
      // add a third uid to a thread -- and the messages read rule grants
      // access purely on membership, so the newcomer could read the entire
      // back history, which in this system routinely contains medical and
      // financial detail (Data Privacy Act §16(b) exposure). They could
      // equally remove the other party.
      //
      // Verified safe: no caller anywhere in src/ writes participants on
      // update. The only conversation updates are the unread counters and
      // last-message denormalisation in src/utils/messages.js and the
      // read-receipt writes in the two admin message components.
      allow update: if isAuth() && uid() in resource.data.participants &&
                       request.resource.data.participants == resource.data.participants;
      allow delete: if isHospitalAdmin(resource.data) || (isAuth() && uid() in resource.data.participants);

      match /messages/{msgId} {
        allow read:   if isAuth() && uid() in
          get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        // Sender must self-attribute, and the text is bounded so a single
        // message can't render a multi-KB block in another participant's
        // thread (the UI textarea is already capped; the rule is the gate).
        allow create: if isAuth() && uid() in
          get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
          // Phase 1.4: `from` is REQUIRED. It was optional
          // (`!('from' in data) || from == uid()`), so omitting the field
          // skipped attribution entirely and let a participant post an
          // unattributed message into a patient/social-worker thread. Same
          // optional-field pattern removed from reports in Phase 1.3.
          // sendMessage() in src/utils/messages.js always sends `from`
          // (it is a required destructured arg and is reused for the
          // conversation's lastFrom / unread counters), so no client change.
          request.resource.data.from == uid() &&
          (!('text' in request.resource.data) ||
           (request.resource.data.text is string && request.resource.data.text.size() <= 5000)) &&
          // Abuse hardening #2: reply-flood cooldown for PATIENTS — a patient's
          // message must be >= 5s after the thread's last message (lastAt, which
          // sendMessage() stamps on every send). Staff are uncapped so their
          // first message / rapid replies aren't blocked. .get(,epoch) so a
          // conversation without lastAt is permissive rather than erroring.
          (!isPatient() ||
           request.time >= get(/databases/$(database)/documents/conversations/$(convId)).data.get('lastAt', timestamp.value(0)) + duration.value(5, 's'));
        allow delete: if isHospitalAdmin(get(/databases/$(database)/documents/conversations/$(convId)).data);
      }
    }

    // ── auditLog ──────────────────────────────────────────────────────────────
    // Reads:
    //   - super_admin: all entries (the gateway oversight of the platform)
    //   - agency_admin: only entries scoped to their own agency. This lets
    //     them satisfy COA-style accountability for their fund usage
    //     without exposing other agencies' operations.
    // Writes: any authenticated user can append, but the actorId MUST equal
    // their auth uid — so an authenticated user can't impersonate a "System"
    // actor or another user by hand-crafting a logAudit body. The earlier
    // version trusted client paths to set actorId honestly, which made the
    // log surface vulnerable to crafted entries (the details field is
    // displayed verbatim in admin/AuditLog and was used as an injection
    // vector against AI agents reviewing the dashboard). The `details`
    // field is bounded at 2000 chars to defang multi-paragraph payloads.
    // Entries are immutable — no updates or deletes ever.
    match /auditLog/{logId} {
      // R33 (§B.26): Activity Timeline reads. Any co-funding agency
      // can read auditLog entries scoped to a request it holds a slice
      // in (entry.requestId matches a request whose agencyIds includes
      // this user's agency). This powers the case timeline on
      // agency/ApplicationDetail. The `requestId` denormalization makes
      // this a single-field check; no expensive multi-doc get() walk.
      //
      // Patient self-read (planned for §B.26 follow-up): a patient can
      // read entries where their uid matches entry.patientId. Surfaces
      // the X-Road citizen-visible audit pattern for RA 10173 §16(c).
      // Hospital super admins read their hospital's entries, plus entries about
      // their hospital's requests written by (tenant-less) agency actors — the
      // request timeline queries by requestId.
      allow read:   if isHospitalSuperAdmin(resource.data) ||
                       (isSuperAdmin() && resource.data.requestId != null &&
                        isHospitalSuperAdmin(get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data)) ||
                       (isAgencyAdmin() && resource.data.actorAgencyId == userAgencyId()) ||
                       (isAgency() && resource.data.requestId != null &&
                        userAgencyId() in get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.agencyIds) ||
                       (isAuth() && resource.data.patientId == uid());
      allow create: if isAuth() &&
                       request.resource.data.actorId == uid() &&
                       // Tenant-less entries come from agency actors; a tagged
                       // entry must carry the writer's own hospital.
                       (!('tenantId' in request.resource.data) || createsInOwnHospital()) &&
                       request.resource.data.details is string &&
                       request.resource.data.details.size() <= 2000;
      allow update, delete: if false;
    }

    // ── notificationErrors ─────────────────────────────────────────────────────
    // Operational log written by the notify() utility when a delivery
    // fails. Without it, delivery failures are invisible until patients
    // complain.
    //
    // Reads: super_admin + staff_admin only — entries can include
    //   recipient UIDs and notification bodies, which are PII-adjacent.
    // Writes: any authenticated user can append (notify() runs from
    //   patient, agency, and admin contexts). The string fields are
    //   bounded so a misconfigured caller — or a malicious one — can't
    //   bury this admin-only collection with multi-KB payloads. The
    //   notify() utility only writes <500 char strings in practice.
    //   Immutable.
    match /notificationErrors/{errorId} {
      allow read:           if isAdmin();
      // Phase 1.4: attributed + `error` required. This was `isAuth()` with
      // every field optional -- structurally the same unbounded write sink
      // that absorbed 18,630 forged records across documentContents and
      // reports during the 2026-06-01 incident. Lower blast radius (it is an
      // ops log, admin-read only) but the same denial-of-wallet vector.
      // notify() populates reportedByUid; if the writer is somehow
      // unauthenticated the log write fails and notify() falls through to its
      // existing console.warn, which is the documented best-effort behaviour.
      allow create:         if isAuth() &&
                               request.resource.data.reportedByUid == uid() &&
                               request.resource.data.error is string &&
                               request.resource.data.error.size() > 0 &&
                               request.resource.data.error.size() <= 2000 &&
                               (!('title' in request.resource.data) ||
                                (request.resource.data.title is string &&
                                 request.resource.data.title.size() <= 200)) &&
                               (!('body' in request.resource.data) ||
                                (request.resource.data.body is string &&
                                 request.resource.data.body.size() <= 2000));
      allow update, delete: if false;
    }

    // ── certificates ──────────────────────────────────────────────────────────
    // Patient reads their own certificate.
    // Agency reads certificates they uploaded.
    // Admins read all.
    // Only agencies and admins can upload.
    //
    // resource == null branch: certificates use the applicationId as their
    // docId, so most apps subscribe to a doc that doesn't exist yet (no
    // signed scan uploaded). Allowing reads of non-existent docs lets
    // onSnapshot fire with snap.exists() === false rather than rejecting
    // with permission-denied. No data leak — they can only probe by appId.
    match /certificates/{certId} {
      allow read: if isAuth() && (
        resource == null ||
        resource.data.patientId == uid() ||
        (isAgency() && resource.data.agencyId == userAgencyId()) ||
        isHospitalAdmin(resource.data)
      );
      // Agencies can only write certs scoped to their own agency. Admins
      // can write any (e.g. moving a cert between agencies during a
      // remediation).
      //
      // Phase 0.4 hardening: forge-protection. Without the appId cross-check,
      // an agency could create a certificate for a different agency's
      // application by setting request.resource.data.agencyId to their own
      // but pointing certId at someone else's appId. We now require:
      //   1. request.resource.data.agencyId == userAgencyId() (existing),
      //   2. the underlying application's agencyId also matches (new).
      // certId is the appId (see comment in src/pages/admin/Patients.jsx:334)
      // so the get() chain resolves cleanly.
      // The GL belongs to its slice's hospital, whoever writes it.
      allow create: if (isAdmin() && createsInOwnHospital()) ||
                       (isAgency() &&
                        request.resource.data.agencyId == userAgencyId() &&
                        get(/databases/$(database)/documents/applications/$(certId)).data.agencyId == userAgencyId() &&
                        tenantOf(request.resource.data) ==
                          tenantOf(get(/databases/$(database)/documents/applications/$(certId)).data));
      allow update: if hospitalAdminWrite() ||
                       (isAgency() &&
                        request.resource.data.agencyId == userAgencyId() &&
                        resource.data.agencyId == userAgencyId() &&
                        tenantOf(request.resource.data) == tenantOf(resource.data));
      allow delete: if isHospitalAdmin(resource.data);
    }

    // ── docReviewPresence ─────────────────────────────────────────────────────
    // Ephemeral presence tracking for concurrent document review awareness.
    match /docReviewPresence/{docId} {
      allow read, write: if isAdmin();
    }

    // ── documentContents ──────────────────────────────────────────────────────
    // Stores file content separately from metadata for query performance.
    // Document ID matches the corresponding documents/{docId}.
    //
    // Phase 0.2 hardening (post-review): the previous rule let ANY agency
    // (role agency or agency_admin) read EVERY patient's document content,
    // not just contents belonging to documents on cases endorsed to them.
    // Coordinators from Agency A could pull medical PDFs of patients only
    // ever endorsed to Agency B -- Data Privacy Act §16(b) violation.
    //
    // Fix mirrors the documents/{docId} read rule (line 219): cross-check
    // the parent documents metadata's agencyIds[] via a get() chain.
    // Adds one rules-eval get() per content read; acceptable at pilot scale
    // (same pattern used by auditLog at lines 399-404).
    match /documentContents/{docId} {
      allow read:   if isAuth() && (
        resource.data.patientId == uid() ||
        isHospitalAdmin(resource.data) ||
        (isAgency() && userAgencyId() in
          get(/databases/$(database)/documents/documents/$(docId)).data.agencyIds)
      );
      // patientId must match auth so a patient can't write content
      // attributed to another patient. The actual file content goes in a
      // single 'content' string (a base64 data URL); we trust the
      // ~1MB Firestore doc cap to bound size rather than enforce it here.
      // Phase 1.2: cap content size at 1MB on create + update. The 10MiB
      // Storage rule guards the actual file; the Firestore content blob
      // (base64) was bounded only by Firestore's 1MiB doc limit. A
      // malicious admin or patient could push 999 KB blobs repeatedly
      // and inflate read costs. Enforce explicitly so the limit is
      // visible in audit + doesn't depend on Firestore catching it.
      // Phase 1.3: a content blob must have a parent documents/{docId}
      // owned by the SAME patient. Before this, the only create condition
      // was "patientId == my uid", so any authenticated patient could
      // write unlimited documentContents at arbitrary ids with no parent
      // — up to 1MB each, forever. The 2026-06-01 injection incident did
      // exactly that: 12,149 orphan blobs (~236MB) under a single uid,
      // none of which had a documents/{docId} parent. Reads were never
      // exposed (the get() chain below scopes them), but the write side
      // was an unbounded storage/cost sink.
      //
      // Safe for both real write paths, which create the parent FIRST:
      //   uploadPatientDocument  — addDoc(documents) then setDoc(contents)
      //   replacePatientDocument — targets an already-existing docId
      // Admin SDK scripts (seed/migrate) bypass rules entirely.
      //
      // Costs one rules-eval get() per upload, same pattern as the read
      // rule above and auditLog at lines 399-404.
      allow create: if isPatient() &&
                       request.resource.data.patientId == uid() &&
                       createsInOwnHospital() &&
                       exists(/databases/$(database)/documents/documents/$(docId)) &&
                       get(/databases/$(database)/documents/documents/$(docId)).data.patientId == uid() &&
                       (!('content' in request.resource.data) ||
                        (request.resource.data.content is string &&
                         request.resource.data.content.size() <= 1000000));
      allow update: if (hospitalAdminWrite() ||
                        (isPatient() && resource.data.patientId == uid() &&
                         tenantOf(request.resource.data) == tenantOf(resource.data))) &&
                       (!('content' in request.resource.data) ||
                        (request.resource.data.content is string &&
                         request.resource.data.content.size() <= 1000000));
      allow delete: if isHospitalAdmin(resource.data) || (isPatient() && resource.data.patientId == uid());
    }

    // ── reports ───────────────────────────────────────────────────────────────
    // Reports include both platform-level issue tickets (read/managed by
    // the gateway admins) and intra-agency Budget Requests (read/managed by the
    // requesting agency's agency_admin). The category field distinguishes
    // them; the gateway admins filter Budget Requests out client-side.
    match /reports/{reportId} {
      allow read:   if isHospitalAdmin(resource.data) ||
                       (isAgencyAdmin() && resource.data.agencyId == userAgencyId());
      // Caller must self-attribute (reportedBy == uid()) and the
      // description is bounded — defends the same admin-visible surface
      // from multi-KB or impersonated submissions.
      // Phase 1.3: every guarded field is now REQUIRED, not optional.
      // The previous rule made each check `!('x' in data) || <valid>`, so
      // simply omitting a field skipped its validation — a forged report
      // needed only {category, reportedBy, description} to pass. The
      // 2026-06-01 injection incident wrote 6,481 such docs under one
      // uid. They stayed invisible because the admin Reports view filters
      // on status, which they omitted entirely.
      //
      // Requiring status == 'open' and createdAt == request.time forces
      // creates through the real UI paths (ProfileModals report modal and
      // the agency budget-request modal), both of which always send
      // status:'open' + serverTimestamp(). Pinning createdAt to
      // request.time also stops backdated entries.
      allow create: if isAuth() &&
                       request.resource.data.reportedBy == uid() &&
                       (!('tenantId' in request.resource.data) || createsInOwnHospital()) &&
                       request.resource.data.status == 'open' &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.category is string &&
                       request.resource.data.category.size() > 0 &&
                       request.resource.data.category.size() <= 100 &&
                       request.resource.data.description is string &&
                       request.resource.data.description.size() > 0 &&
                       request.resource.data.description.size() <= 5000;
      allow update: if hospitalAdminWrite() ||
                       (isAgencyAdmin() && resource.data.agencyId == userAgencyId());
      allow delete: if isHospitalAdmin(resource.data);
    }

    // ── announcements ─────────────────────────────────────────────────────────
    // All authenticated users can read (needed to show banners in Layout).
    // the gateway admins (super/staff) manage ALL announcements. Agency admins may
    // create and manage only their OWN agency-sourced announcements
    // (source == 'agency', matching their agencyId) — these are shown to all
    // patients via the Layout banner.
    match /announcements/{annId} {
      allow read:   if isAuth();
      // Size caps on title/message: announcements render in a Layout
      // banner visible to all users -- a long payload would dominate the
      // viewport. The UI inputs are already maxLength-constrained but the
      // server is the actual gate.
      allow create: if ((isAdmin() && createsInOwnHospital()) ||
                       (isAgencyAdmin() &&
                        request.resource.data.source == 'agency' &&
                        request.resource.data.agencyId == userAgencyId())) &&
                       (!('title' in request.resource.data) ||
                        (request.resource.data.title is string &&
                         request.resource.data.title.size() <= 200)) &&
                       (!('message' in request.resource.data) ||
                        (request.resource.data.message is string &&
                         request.resource.data.message.size() <= 2000));
      allow update: if (hospitalAdminWrite() ||
                       (isAgencyAdmin() &&
                        resource.data.source == 'agency' &&
                        resource.data.agencyId == userAgencyId())) &&
                       (!('title' in request.resource.data) ||
                        (request.resource.data.title is string &&
                         request.resource.data.title.size() <= 200)) &&
                       (!('message' in request.resource.data) ||
                        (request.resource.data.message is string &&
                         request.resource.data.message.size() <= 2000));
      allow delete: if isHospitalAdmin(resource.data) ||
                       (isAgencyAdmin() &&
                        resource.data.source == 'agency' &&
                        resource.data.agencyId == userAgencyId());
    }

    // ── referralSuggestions ──
    // R36 (§B.27): Bonterra warm-handoff pattern. An agency_admin or
    // coordinator at an agency that already holds a slice on a case may
    // suggest that the gateway endorses a SIBLING agency for the same request.
    // the gateway reviews each suggestion -- accept (pre-fills EndorseModal for
    // the target agency) or decline (logs a reason visible to the
    // originating agency). The suggestion does not commit any agency to
    // action; it is an information channel from the ground (agencies)
    // to the network broker (the gateway).
    //
    // Reads:
    //   - admins always
    //   - the originating agency to track their own suggestions
    //   - the target agency to see suggestions directed at them
    // Creates:
    //   - any agency staff for THEIR OWN agency (forgery-resistant)
    //   - status must be 'pending' on create
    //   - reason capped at 1000 chars
    // Updates:
    //   - admins only, status must transition to 'accepted' or 'declined'
    // Deletes:
    //   - never (suggestions are part of the audit trail)
    match /referralSuggestions/{suggestionId} {
      allow read:   if isAuth() && (
                       isHospitalAdmin(resource.data) ||
                       (isAgency() && resource.data.fromAgencyId == userAgencyId()) ||
                       (isAgency() && resource.data.toAgencyId   == userAgencyId())
                     );
      allow create: if isAuth() && isAgency() &&
                       request.resource.data.fromAgencyId == userAgencyId() &&
                       request.resource.data.fromUserId   == uid() &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.reason is string &&
                       request.resource.data.reason.size() <= 1000 &&
                       // Belongs to the case's hospital.
                       tenantOf(request.resource.data) ==
                         tenantOf(get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data) &&
                       // Phase 7: only an agency that hospital partners with.
                       partnersWith(request.resource.data.toAgencyId, tenantOf(request.resource.data));
      allow update: if hospitalAdminWrite() &&
                       request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    // interviewSlots removed — interview scheduling was replaced by async
    // remote assessment (docs/remove-interview-scheduling-plan.md).
  }
}
