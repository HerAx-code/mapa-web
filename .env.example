VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Set to true only during development/setup. Remove or set to false in production.
VITE_ENABLE_SEED=false

# ── Deploying organization (brand) ──────────────────────────────────────────
# MAPA is client-agnostic: the host organization is configurable, not hardcoded.
# Leave these unset for the neutral MAPA defaults, or set them to rebrand the
# whole app (header, Guarantee Letter, intake sheet, access-code prefix, emails)
# for a specific deployment. Read at BUILD time — change + redeploy to apply.
# See src/config/org.js. Geography (BARMM/Cotabato) is NOT brand and stays.
#   VITE_ORG_NAME            Product/short brand name.            Default "MAPA"
#   VITE_ORG_SHORT_NAME      Institution tag under the name.      Default "" (none)
#   VITE_ORG_FULL_NAME       Expanded product name.               Default "Medical Assistance Portal Access"
#   VITE_ORG_GATEWAY_NAME    Office that issues codes / assesses / endorses.
#                            Appears on patient copy + documents. Default "Medical Social Services"
#   VITE_ORG_GATEWAY_INITIALS Monogram for the document seals.    Default "MSS"
#   VITE_ORG_FACILITY_NAME   Host hospital name (admitted at … / your … bill).
#                            Set to the real hospital for correct copy. Default "the hospital"
#   VITE_ORG_CONTACT_EMAIL   Patient support / access-code email. Default "support@example.org"
#   VITE_ACCESS_CODE_PREFIX  Patient Access Code prefix (<PREFIX>-YYYY-NNNNN). Default "MAPA"
#                            Codes from a prior deployment (e.g. a prior prefix) still validate —
#                            see legacyAccessCodePrefixes in src/config/org.js.
# VITE_ORG_NAME=MAPA
# VITE_ORG_GATEWAY_NAME=Medical Social Services
# VITE_ORG_FACILITY_NAME=
# VITE_ORG_CONTACT_EMAIL=
# VITE_ACCESS_CODE_PREFIX=MAPA
#
# The Cloud Function that validates access codes reads ACCESS_CODE_PREFIX
# (no VITE_ prefix) from the Functions environment — keep it in sync.

# Advisory on-device ID verification (face-match + liveness). Enabled by default;
# set to false to disable the whole check (no ~6.6 MB model download) and fall
# back to the OCR-only flow — a rollout kill-switch. See docs/id-verification-plan.md.
VITE_ID_VERIFY_ENABLED=true

# ID capture-quality thresholds (read at BUILD time — change + redeploy to apply).
# Defaults are conservative so a normal photo passes; tune against real-world ID photos.
# The quality gate is advisory with an always-available "Use it anyway" override,
# so these only affect how OFTEN a retake is suggested, never whether a patient can
# submit. Higher = stricter (more retake prompts).
#   MIN_LONG_EDGE  (px)   long edge below which a photo is "too small". Default 600.
#   SHARP_MIN      (0–~40) mean luma gradient below which it's "blurry". Default 5 (low = only obvious blur).
#   DARK_MEAN      (0–255) mean luminance below which it's "too dark". Default 45.
#   GLARE_FRACTION (0–1)   blown-out pixel fraction above which it's "glare". Default 0.35.
#   LOW_OCR_CONFIDENCE (0–100) OCR confidence below which text is "hard to read". Default 55.
#   MODEL_TIMEOUT_MS (ms) cap on each on-device model op (OCR worker/lang-data load +
#     recognize, face-api weights load + detection). On a weak mobile network the
#     ~10 MB OCR lang pack / ~6.6 MB face weights can STALL mid-download without
#     erroring; this bounds the wait so the advisory check — and its spinner
#     ("Reading ID…", "Checking…") — resolves to a neutral result instead of
#     hanging forever. Advisory only, never blocks submit. Default 20000 (20s).
VITE_IDQ_MIN_LONG_EDGE=600
VITE_IDQ_SHARP_MIN=5
VITE_IDQ_DARK_MEAN=45
VITE_IDQ_GLARE_FRACTION=0.35
VITE_IDQ_LOW_OCR_CONFIDENCE=55
VITE_IDQ_MODEL_TIMEOUT_MS=20000

# Error tracking (Sentry). Optional — leave unset to disable entirely (the
# SDK is then never loaded or bundled). Set to your Sentry project DSN in the
# deploy env to activate error reporting. Read at BUILD time (VITE_ prefix),
# so set it before the build and redeploy.
VITE_SENTRY_DSN=

# App Check (bot / abuse protection). Optional — leave unset to disable (no-op).
# Register a reCAPTCHA v3 provider in Firebase Console → App Check to get the
# site key, then set it here (read at BUILD time). Start in monitoring mode,
# then enable enforcement per service. For local dev against an enforcing
# project, also set VITE_APPCHECK_DEBUG=true and register the printed token.
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_DEBUG=false
