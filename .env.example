VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Set to true only during development/setup. Remove or set to false in production.
VITE_ENABLE_SEED=false

# Advisory on-device ID verification (face-match + liveness). Enabled by default;
# set to false to disable the whole check (no ~6.6 MB model download) and fall
# back to the OCR-only flow — a rollout kill-switch. See docs/id-verification-plan.md.
VITE_ID_VERIFY_ENABLED=true

# ID capture-quality thresholds (read at BUILD time — change + redeploy to apply).
# Defaults are conservative so a normal photo passes; tune against real CRMC photos.
# The quality gate is advisory with an always-available "Use it anyway" override,
# so these only affect how OFTEN a retake is suggested, never whether a patient can
# submit. Higher = stricter (more retake prompts).
#   MIN_LONG_EDGE  (px)   long edge below which a photo is "too small". Default 600.
#   SHARP_MIN      (0–~40) mean luma gradient below which it's "blurry". Default 5 (low = only obvious blur).
#   DARK_MEAN      (0–255) mean luminance below which it's "too dark". Default 45.
#   GLARE_FRACTION (0–1)   blown-out pixel fraction above which it's "glare". Default 0.35.
#   LOW_OCR_CONFIDENCE (0–100) OCR confidence below which text is "hard to read". Default 55.
VITE_IDQ_MIN_LONG_EDGE=600
VITE_IDQ_SHARP_MIN=5
VITE_IDQ_DARK_MEAN=45
VITE_IDQ_GLARE_FRACTION=0.35
VITE_IDQ_LOW_OCR_CONFIDENCE=55

# Error tracking (Sentry). Optional — leave unset to disable entirely (the
# SDK is then never loaded or bundled). Set to your Sentry project DSN in the
# deploy env to activate error reporting. Read at BUILD time (VITE_ prefix),
# so set it before the build and redeploy.
VITE_SENTRY_DSN=

# App Check (bot / abuse protection). Optional — leave unset to disable (no-op).
# Register a reCAPTCHA v3 provider in Firebase Console → App Check to get the
# site key, then set it here (read at BUILD time). Start in monitoring mode,
# then enable enforcement per service. For local dev against an enforcing
# project, also set VITE_APPCHECK_DEBUG=true and register the printed token.
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_DEBUG=false
