node_modules
dist
.env

.vercel
.claude/settings.local.json

# Firebase Admin SDK service-account keys.
# Required by scripts/bootstrap-users.js + scripts/repair-demo-accounts.js,
# but NEVER committed -- the file grants full read/write to every
# Firestore document on the project.
service-account.json
service-account-*.json
*-service-account.json
firebase-adminsdk-*.json

# Firestore backups from scripts/export-firestore.js.
# Each run writes ./backups/{ISO-timestamp}/ with one JSON file per
# collection. These contain real patient PII and must never be
# committed to the repo.
backups/
